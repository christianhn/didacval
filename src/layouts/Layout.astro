---
import "../styles/global.scss";
import { siteData } from "../data/site";

type JsonLdEntry = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title?: string;
  description?: string;
  /** Ruta con barra final (p. ej. "/sexologo-zaragoza/"). Por defecto, la actual. */
  canonicalPath?: string;
  /** Imagen social. Puede ser un asset de src/assets o una ruta de /public. */
  ogImage?: { src: string; width?: number; height?: number };
  /** Entradas JSON-LD a volcar en <head>. */
  jsonLd?: JsonLdEntry[];
  noindex?: boolean;
}

const {
  title = "Didac Val — Psicólogo en Zaragoza",
  description = "Psicólogo en Zaragoza: ansiedad y estrés, sexología, terapia individual y adolescentes. Consulta en Paseo de Sagasta 17 y sesiones online. Primera sesión informativa gratuita.",
  canonicalPath,
  ogImage,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// Canonical absoluta. `Astro.site` viene de `site` en astro.config.mjs; el
// fallback mantiene las metas correctas si alguien levanta el build sin config.
const siteOrigin = Astro.site?.origin ?? siteData.url;
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, siteOrigin).href;
const ogImageUrl = ogImage
  ? new URL(ogImage.src, siteOrigin).href
  : new URL("/favicon.png", siteOrigin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {
      noindex && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Didac Val" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      Las fuentes van declaradas en `src/styles/_fonts.scss` (autoalojadas en
      /public/fonts). Antes se pedían al CDN de Google con dos <link> que
      bloqueaban el render de todas las páginas y que además enviaban la IP de
      quien visita a un tercero en una web con formulario de datos personales.
    -->

    {
      jsonLd.map((entry) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(entry)}
          is:inline
        />
      ))
    }
  </head>
  <body>
    <slot />
  </body>

  <script>
    import Lenis from "lenis";
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { supportsScrollChoreography } from "../scripts/motion";

    gsap.registerPlugin(ScrollTrigger);

    // En iOS, plegar la barra de direcciones dispara un `resize` que no es un
    // resize real: solo cambia el alto. ScrollTrigger lo tomaba como señal para
    // refrescar, y `refresh()` re-mide todos los triggers, rehace los pin-spacers
    // y fuerza reflows síncronos... en pleno scroll. Eso es lo que clavaba la
    // página en cuanto aparecía la barra. Con esto solo se refresca si cambia el
    // ancho (rotación, resize real de la ventana).
    ScrollTrigger.config({ ignoreMobileResize: true });

    // Smooth scroll solo en PC (puntero fino + hover), no en táctiles
    if (supportsScrollChoreography()) {
      const lenis = new Lenis({
        anchors: true,
        syncTouch: false,
      });

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    }
  </script>
</html>