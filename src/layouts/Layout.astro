---
import "../styles/global.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  // REVISAR CON DIDAC: confirmar dato real antes de publicar
  title = "Didac Val — Psicología Clínica & Sanitaria | Zaragoza",
  description = "Atención psicológica individualizada en Zaragoza. Estrés, ansiedad, terapia de pareja y sexología. Primera valoración gratuita. Paseo Sagasta 17 y online.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>

  <script>
    import Lenis from "lenis";
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    // Smooth scroll solo en PC (puntero fino + hover), no en táctiles
    const isDesktop = window.matchMedia(
      "(pointer: fine) and (hover: hover)",
    ).matches;

    if (isDesktop) {
      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        anchors: true,
        syncTouch: false,
      });

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    }
  </script>
</html>
