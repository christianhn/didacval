---
import { supportQuoteData } from "../../data/supportQuote";
---

<section class="support-quote" aria-label="Cita de apoyo">
  <div class="support-quote__inner">
    <div class="support-quote__card">
      <div class="support-quote__header">
        <span class="support-quote__eyebrow">{supportQuoteData.eyebrow}</span>
        <span class="support-quote__index">{supportQuoteData.index}</span>
      </div>
      <blockquote class="support-quote__quote">
        {supportQuoteData.quote}
      </blockquote>
      <div class="support-quote__author">
        <div class="support-quote__avatar" aria-hidden="true">
          <span class="material-symbols-outlined"
            >{supportQuoteData.author.icon}</span
          >
        </div>
        <div>
          <div class="support-quote__name">{supportQuoteData.author.name}</div>
          <div class="support-quote__role">{supportQuoteData.author.role}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .support-quote {
    width: 100%;
    background: var(--color-surface-container-low);
    padding: $space-2xl $gutter-mobile;

    @media (min-width: $bp-lg) {
      padding: $space-3xl $gutter-desktop;
    }
  }

  .support-quote__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: flex;
    justify-content: center;
  }

  .support-quote__card {
    display: flex;
    flex-direction: column;
    gap: $space-md;
    background: var(--color-surface-container-lowest);
    padding: $space-lg;
    border-radius: $radius-default;
    box-shadow: 0 0.0625rem 0.375rem rgba(0, 0, 0, 0.06);
    max-width: 35rem;
    width: 100%;
    border-left: 0.1875rem solid var(--color-secondary-fixed-dim);

    @media (min-width: $bp-lg) {
      padding: $space-xl;
    }
  }

  .support-quote__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: $space-xs;
  }

  .support-quote__eyebrow {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .support-quote__index {
    @include text-index-item;
    color: var(--color-on-surface-variant);
  }

  .support-quote__quote {
    @include text-body-base;
    color: var(--color-on-surface);
    margin: 0;
    font-style: italic;
    border: 0;
    padding: 0;
    text-wrap: balance;
  }

  .support-quote__author {
    display: flex;
    align-items: center;
    gap: $space-sm;
    padding-top: $space-xs;
  }

  .support-quote__avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: $radius-full;
    background: var(--color-surface-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    .material-symbols-outlined {
      color: var(--color-secondary);
    }
  }

  .support-quote__name {
    @include text-label-pill;
    color: var(--color-on-surface);
    font-weight: 600;
  }

  .support-quote__role {
    @include text-caption-micro;
    color: var(--color-outline);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.01em;
  }
</style>
