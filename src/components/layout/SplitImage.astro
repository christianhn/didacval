---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import NoteCard, { type Note } from "../ui/NoteCard.astro";

/**
 * Bloque de dos columnas al 50 %.
 *
 * Con imagen, la imagen va a un lado y el texto al otro; en usos consecutivos se
 * alterna el lado con `reverse`.
 *
 * Sin imagen —cuando no hay una segunda foto adecuada en la página y repetir la
 * del hero no vale— las dos columnas son de texto. En ese caso la segunda
 * columna la ocupa el `note`: sin imagen no queda un hueco vacío, y el apunte
 * recibe el peso visual que antes tenía un H3 que competía con el de la
 * sección.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  /** Párrafos de la columna de texto. */
  paragraphs: readonly string[];
  /** Enlace dentro del texto (p. ej. el bloque que ya vive en la portada). */
  paragraphLink?: { label: string; href: string };
  /**
   * "Un apunte" de apoyo: confidencialidad, una advertencia, una condición.
   * Con imagen va debajo de los párrafos; sin imagen, en la segunda columna.
   */
  note?: Note;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Pone la imagen a la izquierda en vez de a la derecha. */
  reverse?: boolean;
  tone?: "base" | "soft";
}

const {
  id,
  eyebrow,
  title,
  description,
  paragraphs,
  paragraphLink,
  note,
  image,
  imageAlt = "",
  reverse = false,
  tone = "base",
} = Astro.props;

const titleId = `${id ?? "split"}-title`;
---

<Section id={id} tone={tone} labelledBy={titleId}>
  <SectionHeader
    id={titleId}
    eyebrow={eyebrow}
    title={title}
    description={description}
  />

  <div class:list={["split-image__grid", { "split-image__grid--reverse": reverse }]}>
    <div class="split-image__text">
      {
        paragraphs.map((paragraph, index) => (
          <p class="split-image__paragraph">
            {paragraph}
            {index === paragraphs.length - 1 && paragraphLink && (
              <>
                {" "}
                <a
                  class="split-image__paragraph-link"
                  href={paragraphLink.href}
                >
                  {paragraphLink.label}
                  <span class="material-symbols-outlined" aria-hidden="true">
                    north_east
                  </span>
                </a>
              </>
            )}
          </p>
        ))
      }

      {
        note && image && (
          <slot name="note">
            <NoteCard text={note.text} label={note.label} />
          </slot>
        )
      }

      <slot />
    </div>

    {
      !image && note && (
        <slot name="note">
          <NoteCard text={note.text} label={note.label} />
        </slot>
      )
    }

    {
      image && (
        <div class="split-image__media">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 46vw, 100vw"
            loading="lazy"
            class="split-image__image"
          />
        </div>
      )
    }
  </div>
</Section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/scale" as *;

  .split-image__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $split-gap-sm;
    align-items: center;

    @media (min-width: $bp-lg) {
      grid-template-columns: $split-columns;
      gap: $split-gap;
    }
  }

  // Sin imagen son dos columnas de texto: se alinean arriba. Centradas, la más
  // corta quedaría flotando en mitad de su columna.
  .split-image__grid:not(:has(.split-image__media)) {
    @media (min-width: $bp-lg) {
      align-items: start;
    }
  }

  .split-image__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $space-md;
    min-width: 0;
  }

  .split-image__paragraph {
    @include type-body;
    margin: 0;
    max-width: 34rem;
    color: var(--color-on-surface-variant);
    text-wrap: pretty;
  }

  // El enlace va dentro del párrafo, no suelto en una esquina: es una
  // referencia a otro bloque, no una llamada a la acción.
  .split-image__paragraph-link {
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
    white-space: nowrap;
    font-weight: 600;
    color: var(--color-on-surface);
    border-bottom: 0.0625rem solid var(--color-outline-variant);
    padding-bottom: 1px;
    transition:
      color 0.2s,
      border-color 0.2s;

    .material-symbols-outlined {
      font-size: 0.9375rem;
    }

    &:hover {
      color: var(--color-secondary);
      border-color: var(--color-secondary);
    }
  }

  .split-image__media {
    position: relative;
    overflow: hidden;
    border-radius: $image-radius;
    background: var(--color-surface-subtle);
    aspect-ratio: 4 / 3;

    @media (min-width: $bp-lg) {
      aspect-ratio: 5 / 4;
    }
  }

  .split-image__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  // La imagen cambia de lado, el texto no: el ojo siempre entra por la izquierda.
  .split-image__grid--reverse .split-image__media {
    @media (min-width: $bp-lg) {
      order: -1;
    }
  }
</style>
