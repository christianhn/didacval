---
import NoteCard from "../ui/NoteCard.astro";
import { processData } from "../../data/process";
---

<section id="proceso" class="process" aria-labelledby="process-title">
  <div class="process__container">
    <!-- COLUMNA IZQUIERDA (FIXED / STICKY SIDEBAR) -->
    <div class="process__sidebar">
      <header class="process__header">
        <span class="process__eyebrow">{processData.eyebrow}</span>
        <h2 id="process-title" class="process__title">{processData.title}</h2>
        <p class="process__desc">{processData.description}</p>
      </header>

      {
        processData.note && (
          /* El envoltorio es lo que lleva el margen de móvil: el `<aside>` lo
             pinta `NoteCard` con su propio ámbito de estilos y no heredaría el
             de este bloque. */
          <div class="process__note">
            <NoteCard text={processData.note} />
          </div>
        )
      }
    </div>

    <!-- COLUMNA DERECHA (STACKED CARDS SCROLL) -->
    <div class="process__stack">
      {
        processData.steps.map((step, index) => (
          <article class="process__step" data-index={index}>
            <div class="process__step-top">
              <span class="process__step-number">{step.number}</span>
              <div class="process__step-heading">
                <span class="process__step-heading-kicker">{step.kicker}</span>
                <h3 class="process__step-heading-title">{step.title}</h3>
                <p class="process__step-heading-desc">{step.description}</p>
                <div class="process__step-heading-meta">
                  <span
                    class="process__step-heading-meta-icon"
                    aria-hidden="true"
                  >
                    {step.metaIcon === "edit_note" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M8 3.5h8a1 1 0 0 1 1 1V5h1.5A1.5 1.5 0 0 1 20 6.5v14A1.5 1.5 0 0 1 18.5 22h-13A1.5 1.5 0 0 1 4 20.5v-14A1.5 1.5 0 0 1 5.5 5H7v-.5a1 1 0 0 1 1-1Z" />
                        <path d="M9 12h6M9 16h4" />
                      </svg>
                    )}
                    {step.metaIcon === "schema" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="6" cy="6" r="2.25" />
                        <circle cx="18" cy="18" r="2.25" />
                        <path d="M8.2 7.6 15.8 16.4M6 8.25V13a3 3 0 0 0 3 3h2" />
                      </svg>
                    )}
                    {step.metaIcon === "psychology_alt" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 3v2.2M12 3c-2.4 0-4 1.7-4 3.8 0 1.2.5 2 .5 3.3 0 1.6-1 2-1 3.7A4 4 0 0 0 11.5 18v2.5M12 3c2.4 0 4 1.7 4 3.8 0 1.2-.5 2-.5 3.3 0 1.6 1 2 1 3.7A4 4 0 0 1 12.5 18v2.5" />
                        <path d="M10 20.5h4" />
                      </svg>
                    )}
                    {step.metaIcon === "task_alt" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="8.5" />
                        <path d="m8.5 12.5 2.3 2.3L15.5 9.8" />
                      </svg>
                    )}
                  </span>
                  <span class="process__step-heading-meta-text">
                    {step.metaText}
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .process {
    position: relative;
    width: 100%;
    background: var(--color-surface, #fcfcfd);
    padding: $space-5xl $gutter-mobile;

    @media (min-width: $bp-lg) {
      padding-block: 15rem;
      padding-inline: $gutter-desktop;
    }

    &__container {
      max-width: $container-max;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: $space-3xl;

      @media (min-width: $bp-lg) {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 5rem;
        align-items: start;
      }
    }

    /* --- SIDEBAR IZQUIERDA (STICKY) --- */
    &__sidebar {
      @media (min-width: $bp-lg) {
        position: sticky;
        top: 20dvh;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
      }
    }

    &__header {
      display: flex;
      flex-direction: column;
    }

    &__eyebrow {
      @include eyebrow(var(--color-eyebrow-accent));
    }

    &__title {
      margin-top: 0rem;
      font-size: 2.6rem;
      margin-bottom: 3rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--color-on-surface, #0f172a);
    }

    &__desc {
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--color-on-surface-variant, #475569);
      margin: 0;
      font-weight: 400;
    }

    /* --- NOTA DE ABAJO EN COLUMNA IZQUIERDA ---
       La tarjeta en sí es `NoteCard.astro`; aquí sólo se coloca. El margen de
       móvil era el que tenía cuando vivía dentro de este bloque. */
    &__note {
      @media (max-width: 64rem) {
        margin-top: 4rem;
      }
    }

    /* --- TARJETAS DERECHA (STACK & SHADOWS) --- */
    &__stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;

      @media (min-width: $bp-lg) {
        gap: 2rem;
      }
    }

    &__step {
      background: var(--color-surface-container-lowest, #ffffff);
      border-radius: 1.25rem;
      padding: 2rem;
      box-shadow:
        0 10px 30px -5px rgba(0, 0, 0, 0.04),
        0 2px 6px -1px rgba(0, 0, 0, 0.02);
      transition:
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        border-color 0.3s ease;

      &:hover {
        transform: translateY(-2px);
        border-color: rgba(37, 99, 235, 0.25);
        box-shadow:
          0 16px 36px -6px rgba(0, 0, 0, 0.07),
          0 4px 12px -2px rgba(37, 99, 235, 0.05);
      }

      &-top {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
      }

      &-number {
        font-size: 2.6rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--color-on-secondary-container);
        min-width: 2.75rem;
        flex-shrink: 0;
      }

      &-heading {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;

        &-kicker {
          font-size: 0.7rem;
          line-height: 12px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          color: var(--color-secondary, #64748b);
        }

        &-title {
          font-size: 1.5rem;
          font-weight: 700;
          letter-spacing: -0.02em;
          color: var(--color-on-surface, #0f172a);
          margin: 0.2rem 0 0 0;
        }

        &-desc {
          font-size: 0.975rem;
          line-height: 1.65;
          color: var(--color-on-surface-variant, #475569);
          margin: 0.75rem 0 0 0;
        }

        &-meta {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          margin-top: 1rem;
          padding: 0.4rem 0.85rem;
          background: var(--color-secondary-btn, #f1f5f9);
          border: 1px solid rgba(0, 0, 0, 0.04);
          border-radius: 9999px;
          color: var(--color-on-surface-variant, #334155);
          font-size: 0.825rem;
          font-weight: 600;

          &-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 1rem;
            height: 1rem;
            flex-shrink: 0;

            svg {
              width: 100%;
              height: 100%;
            }
          }

          &-text {
            line-height: 1;
          }
        }
      }
    }
  }
</style>
