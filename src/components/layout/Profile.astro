---
import { Image } from "astro:assets";
import { profileData } from "../../data/profile";
import didacImg from "../../assets/perfil/didac.jpeg";
---

<section id="sobre-mi" class="profile" aria-labelledby="profile-title">
  <div class="profile__inner">
    <div class="profile__media">
      {
        /* REVISAR CON DIDAC: verificar que los diplomas visibles al fondo (AEPSIS y otros) sean reales y vigentes antes de publicar — la credibilidad ahora viene de la imagen, no de texto */
      }
      <Image
        src={didacImg}
        alt="Didac Val Capdevila — psicólogo en Zaragoza"
        widths={[320, 480, 640]}
        sizes="(max-width: 1024px) 100vw, 480px"
        class="profile__image"
        loading="lazy"
      />
    </div>

    <div class="profile__content">
      <div class="profile__content-inner">
        <h2 id="profile-title" class="profile__title">{profileData.title}</h2>
        <p class="profile__subtitle">{profileData.subtitle}</p>
        <p class="profile__desc">{profileData.description}</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .profile {
    position: relative;
    width: 100%;
    padding: $space-3xl $gutter-mobile;
    background: var(--color-surface);

    @media (min-width: $bp-lg) {
      padding: $space-4xl $gutter-desktop;
    }

    overflow-x: clip;
  }

  .profile__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-xl;
    align-items: center;
    overflow: visible;

    @media (min-width: $bp-lg) {
      grid-template-columns: 7fr 7fr;
      gap: $space-2xl;
      align-items: end;
    }

    @media (min-width: $bp-xl) {
      gap: $space-3xl;
    }
  }

  .profile__media {
    position: relative;
    width: 100%;
    max-width: 34.375rem;
    margin-inline: auto;
    overflow: hidden;
    box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.08);
    padding: 10px;
    background: white;
    border-radius: 18px;

    @media (min-width: $bp-lg) {
      margin-inline: 0;
      max-width: none;
    }
  }

  .profile__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    border-radius: 8px;

    @media (min-width: $bp-lg) {
      aspect-ratio: 4 / 5;
      max-height: 42rem;
    }
  }

  .profile__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;

    @media (min-width: $bp-lg) {
      align-items: stretch;
      justify-content: flex-end;
    }
  }

  .profile__content-inner {
    display: flex;
    flex-direction: column;
    gap: $space-sm;
    width: 100%;
  }

  .profile__title {
    @include text-headline-xl;
    color: var(--color-on-surface);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
    max-width: 30rem;

    @media (min-width: $bp-lg) {
      font-size: 8rem;
      line-height: 0.89;
      letter-spacing: -0.05em;
      font-weight: 500;
      color: #e2e2e2;
      mix-blend-mode: difference;
      margin-left: clamp(-8rem, -10vw, -3.5rem);
      margin-bottom: clamp(1.5rem, 4vw, 5rem);
      max-width: none;
    }

    @media (min-width: $bp-xl) {
      margin-left: clamp(-9rem, -11vw, -6rem);
    }
  }

  .profile__subtitle {
    @include text-profile-subtitle;
    color: var(--color-text-muted);
    margin: 0;
    padding-bottom: $space-xs;

    @media (min-width: $bp-lg) {
      margin-left: -4px;
      // en desktop el subtítulo de la captura es más ligero y pequeño
      // que el mixin 2.4rem; lo afinamos sin romper la escala tipográfica
      font-size: clamp(1.25rem, 1.8vw, 1.65rem);
      line-height: 1.25;
      letter-spacing: -0.02em;
      font-weight: 400;
      opacity: 0.72;
    }
  }

  .profile__desc {
    max-width: 25rem;
    @include text-body-lg;
    color: var(--color-on-surface-variant);
    margin: 1rem 0 0;
    font-size: 1rem;

    &--secondary {
      @include text-body-base;
      color: var(--color-on-surface-variant);
      opacity: 0.95;
    }
  }
</style>
