---
import ArrowButton from "../ui/ArrowButton.astro";
import { siteData } from "../../data/site";

interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, description, ctaLabel, ctaHref } = Astro.props;
---

<!--
  Banda de llamada a la acción a mitad de página. Es el mismo esqueleto del CTA
  del hero y del formulario final, reducido a una línea: sin tarjeta, sin
  imagen, sin competir con la sección que tiene encima.
-->
<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="cta-band__inner">
    <div class="cta-band__text">
      <h2 id="cta-band-title" class="cta-band__title">{title}</h2>
      <p class="cta-band__desc">{description}</p>
    </div>

    <div class="cta-band__actions">
      <ArrowButton
        label={ctaLabel}
        href={ctaHref}
        variant="accent"
        class="cta-band__cta"
      />
      <a class="cta-band__phone" href={siteData.contact.phone.href}>
        <span class="material-symbols-outlined" aria-hidden="true">call</span>
        <span>Llamar al {siteData.contact.phone.spaced}</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .cta-band {
    background: var(--color-surface-bone-dark);
    padding-block: $space-2xl;

    @media (min-width: $bp-lg) {
      padding-block: $space-3xl;
    }
  }

  .cta-band__inner {
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: flex;
    flex-direction: column;
    gap: $space-lg;

    @media (min-width: $bp-lg) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: $space-2xl;
      padding-inline: $gutter-desktop;
    }
  }

  .cta-band__text {
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    min-width: 0;
  }

  .cta-band__title {
    @include text-headline-lg;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .cta-band__desc {
    @include text-body-base;
    margin: 0;
    color: var(--color-on-surface-variant);
    max-width: 34rem;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $space-lg;
  }

  .cta-band__phone {
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    @include text-body-base;
    font-weight: 500;
    color: var(--color-on-surface);
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 0.0625rem solid var(--color-outline-variant);
    transition:
      color 0.2s,
      border-color 0.2s;
    @include focus-ring;

    .material-symbols-outlined {
      font-size: 1.0625rem;
      color: var(--color-secondary);
    }

    &:hover {
      color: var(--color-secondary);
      border-color: var(--color-secondary);
    }
  }
</style>