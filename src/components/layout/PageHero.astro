---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import ArrowButton from "../ui/ArrowButton.astro";
import { siteData } from "../../data/site";
import type { Crumb } from "../../data/structuredData";

/**
 * Hero compacto de subpágina: migas, kicker, H1, subtítulo, CTA con círculo de
 * flecha, enlace de llamada y una imagen.
 *
 * El subtítulo absorbe la que antes era una sección de introducción: si el hero
 * deja de explicar lo básico, la sección siguiente empieza con un titular que ya
 * no tiene nada que sostener.
 *
 * Texto e imagen se alinean por su base (`align-items: stretch` en escritorio):
 * la imagen crece hasta la altura del bloque de texto y nunca queda un hueco de
 * más de un padding de sección debajo de ninguno de los dos.
 */
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  crumbs: readonly Crumb[];
  ctaLabel: string;
  ctaHref: string;
  /** Texto completo del CTA de teléfono (p. ej. "Llamar al 622 58 85 60"). */
  phoneLabel: string;
  phoneHref: string;
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt,
  crumbs,
  ctaLabel,
  ctaHref,
  phoneLabel,
  phoneHref,
} = Astro.props;
---

<section class="page-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__inner">
    <div class="page-hero__text">
      <Breadcrumbs items={crumbs} />

      <div class="page-hero__heading">
        <span class="page-hero__eyebrow">{eyebrow}</span>
        <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
        <p class="page-hero__subtitle">{subtitle}</p>
      </div>

      <div class="page-hero__actions">
        <ArrowButton
          label={ctaLabel}
          href={ctaHref}
          variant="accent"
          class="page-hero__cta"
        />
        <a class="page-hero__phone" href={phoneHref}>
          <span class="material-symbols-outlined" aria-hidden="true">call</span>
          <span>{phoneLabel}</span>
        </a>
      </div>
    </div>

    <div class="page-hero__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="page-hero__image"
      />
      <span class="page-hero__badge">
        <span class="material-symbols-outlined" aria-hidden="true"
          >location_on</span
        >
        <span>{siteData.contact.address.street}</span>
      </span>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/scale" as *;
  @use "../../styles/mixins" as *;

  .page-hero {
    @include section-block;
    @include surface(base);
  }

  .page-hero__inner {
    @include section-inner;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-xl;

    @media (min-width: $bp-lg) {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: $space-3xl;
    }
  }

  .page-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $space-lg;
    min-width: 0;
  }

  .page-hero__heading {
    display: flex;
    flex-direction: column;
    // Sin esto el kicker, que es una píldora, se estira a todo el ancho de la
    // columna y parece un botón hueco en vez de una etiqueta.
    align-items: flex-start;
    gap: $space-md;
  }

  .page-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: $space-2xs $space-sm;
    border-radius: $radius-full;
    background: var(--color-surface-container-low);
    @include type-kicker;
    font-weight: 500;
  }

  .page-hero__title {
    @include type-display;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .page-hero__subtitle {
    @include type-body;
    margin: 0;
    max-width: 34rem;
    color: var(--color-on-surface-variant);
    text-wrap: pretty;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $space-lg;
  }

  .page-hero__phone {
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    @include type-body;
    font-weight: 500;
    color: var(--color-on-surface);
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 0.0625rem solid var(--color-outline-variant);
    transition:
      color 0.2s,
      border-color 0.2s;
    @include focus-ring;

    .material-symbols-outlined {
      font-size: 1.0625rem;
      color: var(--color-secondary);
    }

    &:hover {
      color: var(--color-secondary);
      border-color: var(--color-secondary);
    }
  }

  .page-hero__media {
    position: relative;
    overflow: hidden;
    border-radius: $image-radius;
    background: var(--color-surface-subtle);
    aspect-ratio: 4 / 3;

    // Sin `aspect-ratio` en escritorio: la imagen se estira hasta la altura que
    // imponga el bloque de texto, que es lo que hace que ambos queden a ras.
    // `min-height` es el suelo, para que no quede una franja plana cuando el
    // titular es corto.
    @media (min-width: $bp-lg) {
      aspect-ratio: auto;
      min-height: 26rem;
    }
  }

  .page-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-hero__badge {
    position: absolute;
    bottom: $space-md;
    left: $space-md;
    right: $space-md;
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
    padding: $space-2xs $space-md;
    border-radius: $radius-full;
    background: color-mix(in srgb, var(--color-surface-dark) 62%, transparent);
    color: var(--color-surface-container-lowest);
    @include type-small;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    .material-symbols-outlined {
      font-size: 0.875rem;
      flex: 0 0 auto;
    }
  }
</style>
