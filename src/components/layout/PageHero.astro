---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import ArrowButton from "../ui/ArrowButton.astro";
import { siteData } from "../../data/site";
import type { Crumb } from "../../data/structuredData";

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  crumbs: readonly Crumb[];
  /** CTA principal: apunta al formulario. */
  ctaLabel: string;
  ctaHref: string;
  /** Texto completo del CTA de teléfono (p. ej. "Llamar al 622 58 85 60"). */
  phoneLabel: string;
  phoneHref: string;
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt,
  crumbs,
  ctaLabel,
  ctaHref,
  phoneLabel,
  phoneHref,
} = Astro.props;
---

<!--
  Hero de subpágina. Sin vídeo a propósito: el de la landing pesa y no aporta
  nada aquí. Cabecera de página, migas, titular, subtítulo, CTA principal y
  una imagen a un lado.
-->
<section class="page-hero" aria-labelledby="page-hero-title">
  <div class="page-hero__inner">
    <div class="page-hero__text">
      <Breadcrumbs items={crumbs} />

      <div class="page-hero__heading">
        <span class="page-hero__eyebrow">{eyebrow}</span>
        <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
        <p class="page-hero__subtitle">{subtitle}</p>
      </div>

      <div class="page-hero__actions">
        <ArrowButton
          label={ctaLabel}
          href={ctaHref}
          variant="accent"
          class="page-hero__cta"
        />
        <a class="page-hero__phone" href={siteData.contact.phone.href}>
          <span class="material-symbols-outlined" aria-hidden="true">call</span>
          <span>{phoneLabel}</span>
        </a>
      </div>
    </div>

    <div class="page-hero__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="page-hero__image"
      />
      <span class="page-hero__media-badge">
        <span class="material-symbols-outlined" aria-hidden="true"
          >location_on</span
        >
        <span>{siteData.contact.address.street}</span>
      </span>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .page-hero {
    width: 100%;
    background: var(--color-surface-bone);
    padding-top: $space-lg;
    padding-bottom: $space-2xl;

    @media (min-width: $bp-lg) {
      padding-bottom: $space-3xl;
    }
  }

  .page-hero__inner {
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-xl;
    align-items: center;

    // En escritorio el texto arranca a la misma altura que la imagen en vez de
    // flotar centrado: con la imagen tan alta, centrarlo dejaba medio bloque de
    // aire vacío encima de las migas.
    @media (min-width: $bp-lg) {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: $space-3xl;
      align-items: start;
      padding-inline: $gutter-desktop;
    }
  }

  .page-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $space-lg;
    min-width: 0;
  }

  .page-hero__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $space-md;
  }

  .page-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: $space-2xs $space-sm;
    border-radius: $radius-full;
    background: var(--color-surface-container-low);
    @include eyebrow(var(--color-eyebrow-accent));
    font-weight: 500;
  }

  .page-hero__title {
    @include text-headline-xl;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
    max-width: 22ch;

    @media (min-width: $bp-lg) {
      font-size: 3.75rem;
      line-height: 3.375rem;
      letter-spacing: -0.13rem;
    }
  }

  .page-hero__subtitle {
    @include text-body-lg;
    margin: 0;
    color: var(--color-on-surface-variant);
    max-width: 30rem;
    text-wrap: pretty;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $space-lg;
  }

  .page-hero__phone {
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    @include text-body-base;
    font-weight: 500;
    color: var(--color-on-surface);
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 0.0625rem solid var(--color-outline-variant);
    transition:
      color 0.2s,
      border-color 0.2s;
    @include focus-ring;

    .material-symbols-outlined {
      font-size: 1.0625rem;
      color: var(--color-secondary);
    }

    &:hover {
      color: var(--color-secondary);
      border-color: var(--color-secondary);
    }
  }

  .page-hero__media {
    position: relative;
    overflow: hidden;
    border-radius: $radius-lg;
    background: var(--color-surface-subtle);
    aspect-ratio: 4 / 3;

    // Sin `max-height`: en un contenedor con `aspect-ratio`, un tope de alto
    // hace que el ancho se recalcule a partir de la altura ya fijada y la
    // imagen deja de llenar su columna de la rejilla.
    @media (min-width: $bp-lg) {
      aspect-ratio: 4 / 3;
    }
  }

  .page-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-hero__media-badge {
    position: absolute;
    bottom: $space-md;
    left: $space-md;
    right: $space-md;
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
    padding: $space-2xs $space-md;
    border-radius: $radius-full;
    background: color-mix(in srgb, var(--color-surface-dark) 62%, transparent);
    color: var(--color-surface-container-lowest);
    @include text-caption-sm;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    .material-symbols-outlined {
      font-size: 0.875rem;
      flex: 0 0 auto;
    }
  }
</style>