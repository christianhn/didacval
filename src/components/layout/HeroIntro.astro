---
import { introData } from "../../data/intro";
---

<section id="intro" class="intro" aria-label="Presentación">
  <div class="intro__inner">
    <h2 class="intro__headline">{introData.headline}</h2>

    <a
      class="intro__cta intro__cta--primary"
      href={introData.ctas.primary.href}
    >
      <span>{introData.ctas.primary.label}</span>
      <span class="intro__cta-icon" aria-hidden="true">
        <span class="material-symbols-outlined"
          >{introData.ctas.primary.icon}</span
        >
      </span>
    </a>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .intro {
    width: 100%;
    background: var(--color-surface);
    padding: $space-3xl $gutter-mobile $space-2xl;

    @media (min-width: $bp-lg) {
      padding: $space-4xl $gutter-desktop $space-3xl;
    }
  }

  .intro__inner {
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: $space-lg;
    max-width: $container-max;

    @media (min-width: $bp-lg) {
      gap: $space-xl;
    }
  }

  .intro__headline {
    @include text-headline-xl;
    color: var(--color-on-surface);
    margin: 0;
    text-wrap: balance;
    max-width: 70rem;
    text-align: right;

    @media (min-width: $bp-lg) {
      font-size: 3.875rem;
      line-height: 3.625rem;
      letter-spacing: -0.3125rem;
    }
  }

  .intro__cta {
    display: inline-flex;
    align-items: center;
    border-radius: $radius-full;
    @include text-label-pill;
    transition: all 0.2s;

    &--primary {
      padding: $space-xs $space-2xs $space-xs $space-lg;
      background: var(--color-primary);
      color: var(--color-on-primary);
      box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.12);
      &:hover {
        background: #222;
      }
    }
  }

  .intro__cta-icon {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: $space-xs;
    border-radius: $radius-full;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    .material-symbols-outlined {
      font-size: 0.9375rem;
      color: var(--color-on-primary);
    }
  }
</style>
