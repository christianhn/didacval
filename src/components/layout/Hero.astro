---
import { heroData } from "../../data/hero";
import { profileData } from "../../data/profile";
import natureVideo from "../../assets/hero/nature2.mp4";
---

<section class="hero-video" aria-labelledby="hero-title">
  <video
    class="hero-video__media"
    autoplay
    muted
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src={natureVideo} type="video/mp4" />
  </video>

  <!-- Overlay para legibilidad -->
  <div class="hero-video__overlay" aria-hidden="true"></div>
  <div class="hero-video__vignette" aria-hidden="true"></div>

  <div class="hero-video__content">
    <div class="hero-video__text">
      <h1 id="hero-title" class="hero-video__title">
        <span class="hero-video__eyebrow">{profileData.eyebrow}</span>
        <span class="hero-video__title-main">{heroData.title.line1}</span>
        <span class="hero-video__title-accent">{heroData.title.line2}</span>
      </h1>
    </div>
  </div>

  <!-- Indicador scroll sutil -->
  <a class="hero-video__scroll" href="#intro" aria-label="Seguir leyendo">
    <span>Sigue leyendo</span>
    <span class="material-symbols-outlined" aria-hidden="true"
      >keyboard_arrow_down</span
    >
  </a>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .hero-video {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 35rem;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    background: var(--color-surface-dark);
  }

  .hero-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
    transform: scale(1.05);
    opacity: 1;
    transition: opacity 0.9s ease;
    will-change: opacity;
  }

  .hero-video__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgba(10, 11, 10, 0.72) 0%,
        rgba(10, 11, 10, 0.55) 36%,
        rgba(10, 11, 10, 0.18) 68%,
        rgba(10, 11, 10, 0.06) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 11, 10, 0.38) 0%,
        rgba(10, 11, 10, 0) 28%,
        rgba(10, 11, 10, 0.22) 100%
      );
  }

  .hero-video__vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse at center,
      transparent 56%,
      rgba(0, 0, 0, 0.22) 100%
    );
    pointer-events: none;
  }

  .hero-video__content {
    width: 100%;
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    padding-top: 5rem; // compensa header fixed
    // centrado vertical, alineado a la izquierda
    display: flex;
    align-items: center;
    min-height: 100vh;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .hero-video__text {
    max-width: 47.5rem;
    display: flex;
    flex-direction: column;
    gap: $space-md;
  }

  .hero-video__title {
    @include text-display-hero;
    color: #fff;
    margin: 0;
    text-wrap: balance;
    text-shadow: 0 0.125rem 1.25rem rgba(0, 0, 0, 0.35);
    line-height: 3.75rem;
    letter-spacing: -0.3125rem;

    @media (max-width: 48rem) {
      font-size: 2.5rem;
      line-height: 2.625rem;
    }

    @media (max-width: 30rem) {
      font-size: 2rem;
      line-height: 2.125rem;
    }
  }

  .hero-video__eyebrow {
    @include eyebrow(
      $color: rgba(255, 255, 255, 0.82),
      $tracking: 0.22em
    );
    display: block;
    font-size: 0.6875rem;
    line-height: 1;
    font-weight: 400;
    margin-bottom: $space-md;
    text-shadow: 0 0.0625rem 0.75rem rgba(0, 0, 0, 0.35);

    @media (max-width: 30rem) {
      font-size: 0.625rem;
      letter-spacing: 0.18em;
      margin-bottom: $space-sm;
    }
  }

  .hero-video__title-main {
    display: block;
    font-weight: 500;
  }

  .hero-video__title-accent {
    display: block;
    font-style: italic;
    font-weight: 300;
    color: var(--color-warm-sand);
    margin-top: 0.12em;
    text-shadow: 0 0.125rem 1.125rem rgba(0, 0, 0, 0.35);
  }

  .hero-video__scroll {
    position: absolute;
    left: 50%;
    bottom: $space-lg;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    color: rgba(255, 255, 255, 0.9);
    @include text-caption-micro;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 1;
    }

    .material-symbols-outlined {
      font-size: 1.125rem;
      animation: hero-bounce 1.6s ease-in-out infinite;
    }
  }

  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(0.25rem);
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video__media {
      transition: none;
    }
    .hero-video__scroll .material-symbols-outlined {
      animation: none;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video__media");
  if (video) {
    const FADE_SEC = 0.5;
    const PLAY_SEC = 1;

    video.muted = true;
    video.playbackRate = PLAY_SEC;
    video.play().catch(() => {});

    video.addEventListener("timeupdate", () => {
      if (!video.duration || Number.isNaN(video.duration)) return;
      const timeLeft = video.duration - video.currentTime;
      if (timeLeft <= FADE_SEC && timeLeft > 0.05) {
        video.style.opacity = "0";
      }
    });

    video.addEventListener("ended", () => {
      video.currentTime = 0;
      void video.offsetWidth;
      video.style.opacity = "1";
      video.playbackRate = PLAY_SEC;
      video.play().catch(() => {});
    });

    video.addEventListener("seeked", () => {
      if (video.currentTime < 0.2) {
        requestAnimationFrame(() => {
          video.style.opacity = "1";
        });
      }
    });
  }
</script>
