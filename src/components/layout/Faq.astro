---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import handImg from "../../assets/ask/hand.jpg";
import { faqData } from "../../data/faq";

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  /** Reemplaza el array de la landing. Si se omite, usa `faqData.items`. */
  items?: readonly FaqItem[];
  title?: string;
  description?: string;
  eyebrow?: string;
  id?: string;
  /**
   * `portrait` (por defecto) es el bloque de la landing: columna de imagen con
   * el titular superpuesto + lista de acordeones. `plain` quita la imagen y
   * deja sólo la lista, para las subpáginas, donde la imagen ya está en el hero
   * y repetirse restaría.
   */
  variant?: "portrait" | "plain";
  /** Imagen de la columna lateral. Por defecto, la mano de la landing. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  items = faqData.items,
  title = faqData.title,
  description = faqData.description,
  eyebrow,
  id = "faq",
  variant = "portrait",
  image = handImg,
  imageAlt = "Ilustración de mano",
} = Astro.props;

const titleId = `${id}-title`;
---

<section
  id={id}
  class:list={["faq", `faq--${variant}`]}
  aria-labelledby={titleId}
>
  <div class="faq__inner">
    {
      variant === "portrait" && (
        <div class="faq__intro">
          <Image
            src={image}
            alt={imageAlt}
            class="faq__hero-image"
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 40vw, 100vw"
            loading="lazy"
          />

          <div class="faq__text-overlay">
            {eyebrow && <span class="faq__eyebrow">{eyebrow}</span>}
            <h2 id={titleId} class="faq__title">{title}</h2>
            <p class="faq__desc">{description}</p>
          </div>
        </div>
      )
    }

    {
      variant === "plain" && (
        <header class="faq__header">
          {eyebrow && <span class="faq__eyebrow">{eyebrow}</span>}
          <h2 id={titleId} class="faq__title">{title}</h2>
          <p class="faq__desc">{description}</p>
        </header>
      )
    }

    {/* Sin `role="list"`: sus hijos son <details>, no <li>, y el rol
        declarado sin los hijos que exige es un error de accesibilidad. */}
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item" name={`${id}-group`}>
            <summary class="faq__question">
              <h3>{item.question}</h3>
              <span
                class="material-symbols-outlined faq__icon"
                aria-hidden="true"
              >
                add
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .faq {
    width: 100%;
    background: var(--color-surface-bone);
    padding: $space-4xl $gutter-mobile;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }

    // --- Header ---
    &__header {
      max-width: $container-max;
      margin-inline: auto;
      margin-bottom: $space-2xl;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: $space-xs;
    }

    // --- Layout ---
    &__inner {
      max-width: $container-max;
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: $space-2xl;

      @media (min-width: $bp-lg) {
        grid-template-columns: 4fr 8fr;
      }
    }

    // En variante `plain` no hay columna de imagen: la lista ocupa el ancho de
    // lectura y no se queda pegada a una mitad vacía.
    &--plain &__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: $space-2xl;
      max-width: 52rem;
    }

    &--plain &__list {
      position: static;
    }

    // --- Intro (imagen + overlay de texto) ---
    &__intro {
      position: relative;
      border-radius: $radius-default;
      overflow: hidden;
      min-height: 32rem;

      @media (min-width: $bp-lg) {
        min-height: 40rem;
      }

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
          to bottom,
          transparent 0%,
          transparent 50%,
          color-mix(in srgb, var(--color-primary) 50%, transparent) 100%
        );
        pointer-events: none;
      }
    }

    &__hero-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__text-overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
      padding: $space-2xl;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      gap: $space-sm;
    }

    &__eyebrow {
      @include eyebrow(
        var(--color-eyebrow-accent),
        0.1em
      );
    }

    &__title {
      @include text-headline-xl;
      color: var(--color-on-surface);
      margin: 0;
      margin-left: -3px;
      text-wrap: balance;

      .faq--portrait & {
        color: var(--color-surface-container-lowest);
      }
    }

    &__desc {
      @include text-body-sm;
      margin: 0;
      max-width: 30rem;
      color: var(--color-on-surface-variant);

      .faq--portrait & {
        color: color-mix(
          in srgb,
          var(--color-surface-container-lowest) 90%,
          transparent
        );
      }
    }

    // --- Lista de preguntas ---
    &__list {
      display: flex;
      flex-direction: column;
      gap: $space-xs;

      @media (min-width: $bp-lg) {
        align-self: start;
        position: sticky;
        top: var(--faq-sticky-top, 0px);
      }
    }

    &--plain &__list {
      @media (min-width: $bp-lg) {
        position: static;
        align-self: stretch;
      }
    }

    &__item {
      background: var(--color-surface-container-lowest);
      padding: $space-lg;
      border-radius: $radius-default;
      cursor: pointer;
      transition: background 0.2s;

      &:hover {
        box-shadow: 0 0.0625rem 0.375rem
          color-mix(in srgb, var(--color-primary) 8%, transparent);
      }
    }

    &__item[open] &__icon {
      transform: rotate(45deg);
    }

    &__question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: $space-sm;
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }

      h3 {
        @include text-headline-sm;
        color: var(--color-on-surface);
        margin: 0;
        font-size: 1.0625rem;
      }
    }

    &__icon {
      color: var(--color-secondary);
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    &__answer {
      overflow: hidden;
      height: 0;
      opacity: 0;

      & > p {
        padding-top: $space-sm;
        @include text-body-base;
        font-weight: 300;
        color: var(--color-on-surface-variant);
        line-height: 1.7;
        margin: 0;
      }
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const intro = document.querySelector<HTMLElement>(".faq__intro");
  const heroImage = document.querySelector<HTMLElement>(".faq__hero-image");

  // Sólo hay paralaje si la variante trae imagen (la subpágina usa `plain`).
  if (
    intro &&
    heroImage &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    gsap.set(heroImage, { scale: 1.15, yPercent: -7 });

    gsap.to(heroImage, {
      yPercent: 7,
      ease: "none",
      scrollTrigger: {
        trigger: intro,
        start: "top bottom",
        end: "bottom top",
        scrub: true,
        invalidateOnRefresh: true,
      },
    });
  }

  document.querySelectorAll<HTMLElement>(".faq__list").forEach((list) => {
    const updateStickyTop = () => {
      if (!list) return;

      if (!window.matchMedia("(min-width: 64rem)").matches) {
        list.style.removeProperty("--faq-sticky-top");
        return;
      }

      list.style.setProperty(
        "--faq-sticky-top",
        `${Math.max(16, window.innerHeight / 2 - list.offsetHeight / 2)}px`,
      );
    };

    updateStickyTop();
    // Igual que en el resto: el pliegue de la barra en móvil cambia el alto,
    // no el ancho, y no debe reescribir la variable.
    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      updateStickyTop();
    });

    if ("ResizeObserver" in window) {
      new ResizeObserver(updateStickyTop).observe(list);
    }
  });

  const closeItem = (item: HTMLElement, onComplete?: () => void) => {
    const answer = item.querySelector<HTMLElement>(".faq__answer");
    const text = answer?.querySelector<HTMLElement>("p");
    if (!answer || !text) return;

    gsap.killTweensOf([answer, text]);

    gsap.to(text, {
      y: 40,
      opacity: 0,
      duration: 0.4,
      ease: "power2.inOut",
      overwrite: "auto",
    });
    gsap.to(answer, {
      height: 0,
      opacity: 0,
      duration: 0.4,
      ease: "power2.inOut",
      overwrite: "auto",
      onComplete: () => {
        item.open = false;
        onComplete?.();
      },
    });
  };

  const openItem = (item: HTMLElement) => {
    const answer = item.querySelector<HTMLElement>(".faq__answer");
    const text = answer?.querySelector<HTMLElement>("p");
    if (!answer || !text) return;

    gsap.killTweensOf([answer, text]);
    gsap.set(answer, { height: 0, opacity: 0 });
    gsap.set(text, { y: 40, opacity: 0 });

    item.open = true;

    gsap.to(answer, {
      height: "auto",
      opacity: 1,
      duration: 0.4,
      ease: "power2.inOut",
      overwrite: "auto",
    });
    gsap.to(text, {
      y: 0,
      opacity: 1,
      duration: 0.4,
      ease: "power2.inOut",
      delay: 0.1,
      overwrite: "auto",
    });
  };

  document.querySelectorAll<HTMLElement>(".faq__item").forEach((item) => {
    const summary = item.querySelector<HTMLElement>(".faq__question");
    if (!summary) return;

    const answer = item.querySelector<HTMLElement>(".faq__answer");
    const text = answer?.querySelector<HTMLElement>("p");
    if (answer && text) {
      gsap.set(answer, { height: 0, opacity: 0 });
      gsap.set(text, { y: 40, opacity: 0 });
    }

    item.addEventListener("click", (e) => {
      e.preventDefault();

      if (item.open) {
        closeItem(item);
      } else {
        // Un acordeón por grupo: abrir uno cierra el resto del mismo grupo
        // (`name` los agrupa), no los de la página.
        const openItems = Array.from(
          item.parentElement?.querySelectorAll<HTMLElement>(
            ".faq__item[open]",
          ) ?? [],
        ).filter((el) => el !== item);

        if (openItems.length > 0) {
          let remaining = openItems.length;
          openItems.forEach((other) => {
            closeItem(other, () => {
              remaining--;
              if (remaining === 0) openItem(item);
            });
          });
        } else {
          openItem(item);
        }
      }
    });
  });
</script>