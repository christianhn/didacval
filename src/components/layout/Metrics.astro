---
import { metricsData } from "../../data/metrics";
---

<section class="metrics" aria-labelledby="metrics-title">
  <div class="metrics__inner">
    <header class="metrics__header">
      <div>
        <span class="metrics__eyebrow">{metricsData.eyebrow}</span>
        <h2 id="metrics-title" class="metrics__title">{metricsData.title}</h2>
      </div>
      <p class="metrics__desc">{metricsData.description}</p>
    </header>

    <div class="metrics__grid">
      {
        metricsData.items.map((item) => (
          <article class="metrics__card">
            <div class="metrics__card-top">
              <span
                class:list={[
                  "metrics__counter",
                  `metrics__counter--${item.metricVariant}`,
                ]}
              >
                {item.metric}
              </span>
              <span
                class="material-symbols-outlined metrics__icon"
                aria-hidden="true"
              >
                {item.icon}
              </span>
            </div>
            <h3 class="metrics__card-title">{item.title}</h3>
            <p class="metrics__card-desc">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .metrics {
    width: 100%;
    background: var(--color-surface-container-lowest);
    padding: $space-3xl $gutter-mobile;
    box-shadow: 0 0.0625rem 0.25rem rgba(0, 0, 0, 0.04);

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .metrics__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: $space-xl;
  }

  .metrics__header {
    display: flex;
    flex-direction: column;
    gap: $space-sm;
    padding-bottom: $space-sm;

    @media (min-width: $bp-md) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .metrics__eyebrow {
    @include text-caption-micro;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
    font-weight: 600;
  }

  .metrics__title {
    @include text-headline-xl;
    color: var(--color-on-surface);
    margin: 0.25rem 0 0;
  }

  .metrics__desc {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    max-width: 28rem;
    margin: 0;
  }

  .metrics__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-md;

    @media (min-width: $bp-md) {
      grid-template-columns: repeat(2, 1fr);
    }
    @media (min-width: $bp-lg) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metrics__card {
    display: flex;
    flex-direction: column;
    gap: $space-sm;
    background: var(--color-surface);
    padding: $space-lg;
    border-radius: $radius-default;
  }

  .metrics__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .metrics__counter {
    @include text-metric-counter;
    font-weight: 300;

    &--secondary {
      color: var(--color-secondary);
    }
    &--on-surface {
      color: var(--color-on-surface);
    }
  }

  .metrics__icon {
    color: var(--color-secondary);
    font-size: 1.5rem;
  }

  .metrics__card-title {
    @include text-headline-sm;
    color: var(--color-on-surface);
    margin: 0;
  }

  .metrics__card-desc {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>
