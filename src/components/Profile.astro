---
import { Image } from "astro:assets";
import { profileData } from "../data/profile";
import didacImg from "../assets/perfil/didac.jpeg";
---

<section id="sobre-mi" class="profile" aria-labelledby="profile-title">
  <div class="profile__inner">
    <div class="profile__media">
      {
        /* REVISAR CON DIDAC: verificar que los diplomas visibles al fondo (AEPSIS y otros) sean reales y vigentes antes de publicar — la credibilidad ahora viene de la imagen, no de texto */
      }
      <Image
        src={didacImg}
        alt="Didac Val Capdevila — psicólogo en Zaragoza"
        widths={[320, 480, 640]}
        sizes="(max-width: 1024px) 100vw, 480px"
        class="profile__image"
        loading="lazy"
      />
    </div>

    <div class="profile__content">
      <h2 id="profile-title" class="profile__title">{profileData.title}</h2>
      <p class="profile__subtitle">{profileData.subtitle}</p>
      <p class="profile__desc">{profileData.description}</p>

      <ul class="profile__tags" role="list">
        {profileData.tags.map((tag) => <li class="profile__tag">{tag}</li>)}
      </ul>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/typography" as *;

  .profile {
    width: 100%;
    // background: var(--color-surface-container-low);
    padding: $space-3xl $gutter-mobile;

    @media (min-width: $bp-lg) {
      padding: $space-4xl $gutter-desktop;
    }
  }

  .profile__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-xl;
    align-items: center;

    @media (min-width: $bp-lg) {
      grid-template-columns: 5fr 7fr;
      gap: $space-2xl;
    }
  }

  .profile__media {
    position: relative;
    width: 100%;
    max-width: 550px;
    margin-inline: auto;
    border-radius: $radius-default;
    overflow: hidden;
    background: var(--color-surface-container-high);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);

    @media (min-width: $bp-lg) {
      margin-inline: 0;
    }
  }

  .profile__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
  }

  .profile__content {
    display: flex;
    flex-direction: column;
    gap: $space-sm;
  }

  .profile__title {
    @include text-headline-xl;
    color: var(--color-on-surface);
    margin: 0;
  }

  .profile__subtitle {
    @include text-profile-subtitle;
    color: var(--color-text-muted);
    margin: 0;
    padding-bottom: $space-xs;
  }

  .profile__desc {
    @include text-body-lg;
    color: var(--color-on-surface-variant);
    margin: 1rem 0 0;
    max-width: 38rem;
    font-size: 1rem;

    &--secondary {
      @include text-body-base;
      color: var(--color-on-surface-variant);
      opacity: 0.95;
    }
  }

  .profile__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: $space-sm 0 0;
    margin: 0;
  }

  .profile__tag {
    @include text-caption-micro;
    color: var(--color-on-surface);
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    padding: 6px 12px;
    border-radius: $radius-full;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
  }
</style>
