---
/**
 * Fila de contenido del patrón "filas separadas por líneas finas" (el mismo
 * lenguaje que la sección "Áreas en detalle" de la landing, pero sin la rejilla
 * de tres columnas ni la animación de entrada: aquí las filas son estáticas y
 * caben en el ancho de lectura de una subpágina).
 */
interface Props {
  icon?: string;
  kicker?: string;
  title: string;
  /** Convierte el título en enlace. Se usa para las filas que son páginas. */
  href?: string;
  subtitle?: string;
  bullets?: readonly string[];
  /** Texto del enlace secundario de la fila, a la derecha. */
  ctaLabel?: string;
}

const { icon, kicker, title, href, subtitle, bullets, ctaLabel } = Astro.props;
const hasBullets = !!bullets?.length;
// Sin viñetas la fila no necesita la segunda columna: reserving media pantalla
// para una columna vacía descuadra el bloque y deja la lista descompensada.
const isCompact = !hasBullets;
---

<li class:list={["list-row", { "list-row--compact": isCompact }]}>
  {
    icon && (
      <span class="list-row__icon" aria-hidden="true">
        <span class="material-symbols-outlined">{icon}</span>
      </span>
    )
  }

  <div class="list-row__main">
    {kicker && <span class="list-row__kicker">{kicker}</span>}
    <h3 class="list-row__title">
      {
        href ? (
          <a class="list-row__link" href={href}>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    {subtitle && <p class="list-row__subtitle">{subtitle}</p>}

    {
      // En fila compacta (sin viñetas) la flecha va debajo del título, pegada a
      // él. En su propia columna quedaba al fondo de una rejilla con la mitad
      // vacía y se leía como algo que no tenía que ver con la fila.
      isCompact && href && ctaLabel && (
        <span class="list-row__cta" aria-hidden="true">
          {ctaLabel}
          <span class="material-symbols-outlined">north_east</span>
        </span>
      )
    }
  </div>

  {
    hasBullets && (
      <ul class="list-row__bullets">
        {bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }

  {
    !isCompact && href && ctaLabel && (
      <span class="list-row__cta" aria-hidden="true">
        {ctaLabel}
        <span class="material-symbols-outlined">north_east</span>
      </span>
    )
  }
</li>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .list-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-sm;
    align-items: start;
    padding-block: $space-lg;
    border-top: 0.0625rem solid var(--color-outline-variant-transparent);

    @media (min-width: $bp-md) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: $space-xl;
      padding-block: $space-lg;
    }

    @media (min-width: $bp-lg) {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.15fr);
      gap: $space-2xl;
      padding-block: $space-xl;
    }
  }

  .list-row--compact {
    @media (min-width: $bp-md) {
      grid-template-columns: minmax(0, 1fr);
    }

    @media (min-width: $bp-lg) {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  .list-row__icon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0.0625rem solid var(--color-outline-variant);
    border-radius: $radius-full;
    color: var(--color-secondary);

    .material-symbols-outlined {
      font-size: 1.25rem;
    }

    @media (min-width: $bp-lg) {
      display: inline-flex;
    }
  }

  .list-row__main {
    display: flex;
    flex-direction: column;
    gap: $space-3xs;
    min-width: 0;
  }

  .list-row__kicker {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .list-row__title {
    @include text-headline-sm;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .list-row__link {
    color: inherit;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-outline-variant);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
    @include focus-ring;

    &:hover {
      color: var(--color-secondary);
      text-decoration-line: underline;
      text-decoration-color: var(--color-secondary);
    }
  }

  .list-row__subtitle {
    @include text-body-base;
    margin: 0;
    color: var(--color-on-surface-variant);
    max-width: 34rem;
  }

  .list-row__bullets {
    margin: 0;
    padding-left: $space-md;
    list-style-type: disc;
    list-style-position: outside;
    min-width: 0;

    li {
      @include text-body-base;
      color: var(--color-on-surface-variant);

      & + li {
        margin-top: $space-2xs;
      }

      &::marker {
        color: var(--color-secondary);
      }
    }
  }

  .list-row__cta {
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
    margin-top: $space-3xs;
    @include text-body-sm;
    font-weight: 600;
    color: var(--color-secondary);

    .material-symbols-outlined {
      font-size: 0.9375rem;
    }

    // Sólo en las filas con viñetas hay una tercera columna donde colocar la
    // flecha; en las compactas va dentro del bloque de texto (más arriba).
    .list-row:not(.list-row--compact) & {
      display: none;
      margin-top: 0;

      @media (min-width: $bp-lg) {
        display: inline-flex;
        justify-self: end;
      }
    }
  }
</style>