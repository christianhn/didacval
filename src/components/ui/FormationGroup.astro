---
export interface FormationEntry {
  title: string;
  /** Instituciones formadoras. */
  institutions?: readonly string[];
  items: readonly string[];
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  groups: readonly FormationEntry[];
}

const { id, eyebrow, title, description, groups } = Astro.props;
const titleId = `${id ?? "formacion"}-title`;
---

<section id={id} class="formation" aria-labelledby={titleId}>
  <div class="formation__inner">
    <header class="formation__header">
      {eyebrow && <span class="formation__eyebrow">{eyebrow}</span>}
      <h2 id={titleId} class="formation__title">{title}</h2>
      {description && <p class="formation__desc">{description}</p>}
    </header>

    <div class="formation__groups">
      {
        groups.map((group) => (
          <article class="formation__group">
            <h3 class="formation__group-title">{group.title}</h3>

            {group.institutions && group.institutions.length > 0 && (
              <p class="formation__group-institutions">
                {group.institutions.join(" · ")}
              </p>
            )}

            <ul class="formation__items">
              {group.items.map((item) => (
                <li class="formation__item">
                  <span class="material-symbols-outlined" aria-hidden="true">
                    check
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .formation {
    background: var(--color-surface-bone);
    padding-block: $space-3xl;

    @media (min-width: $bp-lg) {
      padding-block: $space-4xl;
    }
  }

  .formation__inner {
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: flex;
    flex-direction: column;
    gap: $space-2xl;

    @media (min-width: $bp-lg) {
      gap: $space-3xl;
      padding-inline: $gutter-desktop;
    }
  }

  .formation__header {
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    max-width: 40rem;
  }

  .formation__eyebrow {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .formation__title {
    @include text-headline-xl;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .formation__desc {
    @include text-body-base;
    margin: 0;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .formation__groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;

    @media (min-width: $bp-lg) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: $space-2xl;
    }
  }

  .formation__group {
    padding-block: $space-xl;
    border-top: 0.0625rem solid var(--color-outline-variant-transparent);
    min-width: 0;

    @media (min-width: $bp-lg) {
      padding-block: $space-lg $space-2xl;
    }
  }

  .formation__group-title {
    @include text-headline-sm;
    margin: 0 0 $space-2xs;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .formation__group-institutions {
    @include text-caption-sm;
    margin: 0 0 $space-md;
    color: var(--color-secondary);
  }

  .formation__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: $space-sm;
  }

  .formation__item {
    display: flex;
    align-items: flex-start;
    gap: $space-sm;
    @include text-body-base;
    color: var(--color-on-surface-variant);
    line-height: 1.5;

    .material-symbols-outlined {
      flex: 0 0 auto;
      font-size: 1rem;
      line-height: 1.5rem;
      color: var(--color-secondary);
    }
  }
</style>