---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PlaceholderIcon from "./PlaceholderIcon.astro";

interface Props {
  image?: ImageMetadata;
  /** Línea corta que acompaña al enlace; forma su nombre accesible. */
  short?: string;
  imageAlt?: string;
  title: string;
  kicker: string;
  description: string;
  /** Página interior de la especialidad: la imagen es el enlace. */
  href: string;
  /** CTA secundario (formulario). */
  cta: { href: string; label: string };
}

const { image, imageAlt, title, kicker, description, short, href, cta } =
  Astro.props;

// El enlace principal es la imagen y su título: es la superficie grande y la
// que la gente elige. El CTA de abajo es una acción distinta ("consultar mi
// caso"), así que sigue siendo un enlace aparte y no un duplicado del primero.
const linkLabel = `${title}. ${short ?? description}`.trim();
---

<article class="specialty-card">
  <a class="specialty-card__media" href={href} aria-label={linkLabel}>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? ""}
          widths={[400, 640, 960]}
          sizes="(min-width: 64rem) 340px, (min-width: 40rem) 50vw, 92vw"
          loading="lazy"
        />
      ) : (
        <PlaceholderIcon />
      )
    }
    <div class="specialty-card__overlay" aria-hidden="true">
      <h3 class="specialty-card__overlay-title">{title}</h3>
    </div>
  </a>

  <!--
    Sin `aria-hidden`: el panel se dibuja al hacer hover, pero para teclado y
    lectores de pantalla su contenido debe estar disponible siempre. Marcarlo
    oculto dejaba además enlaces enfocables dentro de un `aria-hidden`, que es
    un error de accesibilidad. `:focus-within` hace que el panel aparezca al
    tabular sobre él.
  -->
  <div class="specialty-card__reveal">
    <div class="specialty-card__reveal-inner">
      <div class="specialty-card__body">
        <span class="specialty-card__kicker">{kicker}</span>
        <h3 class="specialty-card__title">{title}</h3>
        <p class="specialty-card__desc">{description}</p>
      </div>
      <span class="specialty-card__actions">
        <a class="specialty-card__more" href={href}>
          <span>Ver {title.toLowerCase()}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </span>
    </div>
  </div>
</article>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  // --- tokens de la card mapeados a variables globales ---
  $ink: var(--color-on-surface);
  $muted: var(--color-on-surface-variant);
  // Verde oscuro de kicker (no el verde medio de marca): sobre blanco el
  // segundo daba 3.9:1 y no llegaba al 4.5:1 que exige AA a 9px.
  $accent: var(--color-eyebrow-accent);
  $media-bg: var(--color-surface-subtle);

  // --- mixin: evita repetir la lista de propiedades en reposo/hover ---
  @mixin media-transition($duration, $easing, $delay: 0s) {
    transition:
      top $duration $easing $delay,
      left $duration $easing $delay,
      right $duration $easing $delay,
      height $duration $easing $delay,
      border-radius $duration $easing $delay;
  }

  .specialty-card {
    position: relative;
    background: var(--color-surface-container-lowest);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-primary) 4%, transparent);
    box-shadow: 0 1px 12px
      color-mix(in srgb, var(--color-primary) 4%, transparent);
    height: 28rem;
    isolation: isolate;
    outline: none;

    // 4 columnas a partir de 64rem: con textos largos (4-5 líneas) el bloque
    // que se revela al hacer hover necesita ~15.5rem bajo la imagen, que al
    // ancho mínimo del breakpoint (225px de tarjeta) no cabía en 29rem.
    @media (min-width: $bp-lg) {
      height: 31rem;
    }
  }

  .specialty-card__media {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    overflow: hidden;
    border-radius: 1rem;
    background: $media-bg;
    will-change: top, left, right, height, border-radius;
    z-index: 1;
    display: block;
    cursor: pointer;
    @include focus-ring;
    @include media-transition(0.62s, cubic-bezier(0.33, 0.72, 0, 1));

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 1.1s cubic-bezier(0.22, 0.72, 0, 1);
      will-change: transform;
    }
  }

  .specialty-card__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.2rem 1rem 1.15rem;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-primary) 58%, transparent) 8%,
      color-mix(in srgb, var(--color-primary) 28%, transparent) 42%,
      color-mix(in srgb, var(--color-primary) 6%, transparent) 68%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.32s ease;
  }

  .specialty-card__overlay-title {
    margin: 0;
    font-family: $font-family-base;
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--color-surface-container-lowest);
    text-wrap: balance;
    padding-left: 0.15rem;
    text-shadow: 0 1px 12px
      color-mix(in srgb, var(--color-primary) 35%, transparent);
    max-width: 94%;

    @media (min-width: $bp-lg) {
      font-size: 1.18rem;
    }
  }

  .specialty-card__reveal {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.38s cubic-bezier(0.22, 0.72, 0, 1);
  }

  .specialty-card__reveal-inner {
    display: flex;
    flex-direction: column;
    padding: 0.95rem 0 0;
  }

  .specialty-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0 1rem;
  }

  .specialty-card__kicker {
    font-family: $font-family-base;
    font-size: 0.58rem;
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 700;
    color: $accent;
  }

  .specialty-card__title {
    margin: 0.15rem 0 0;
    font-family: $font-family-base;
    font-size: 1.8rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: $ink;
    text-wrap: balance;
  }

  .specialty-card__desc {
    margin: 0.35rem 0 0;
    font-family: $font-family-base;
    font-size: 0.8rem;
    line-height: 1.55;
    color: $muted;
  }

  // Los dos enlaces del panel revelado: el de la página (principal) y el CTA
  // al formulario (secundario).
  .specialty-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: 0.9rem;
    padding: 0 1rem 1.05rem;
  }

  .specialty-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: $font-family-base;
    font-size: 0.8rem;
    font-weight: 700;
    color: $ink;
    letter-spacing: -0.01em;
    pointer-events: auto;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      gap 0.2s,
      opacity 0.2s,
      text-decoration-color 0.2s;
    @include focus-ring;

    span:last-child {
      font-size: 0.8rem;
      transition: transform 0.2s;
    }

    &:hover {
      gap: 0.5rem;
      opacity: 0.75;
      text-decoration-color: currentColor;
      span:last-child {
        transform: translateX(2px);
      }
    }
  }

  .specialty-card__more {
    color: var(--color-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .specialty-card:hover,
    .specialty-card:focus-within {
      .specialty-card__media {
        top: 0.625rem;
        left: 0.625rem;
        right: 0.625rem;
        height: 50%;
        border-radius: 0.75rem;
        @include media-transition(0.78s, cubic-bezier(0.22, 1, 0.36, 1));
      }

      .specialty-card__media img {
        transform: scale(1.02);
      }

      .specialty-card__overlay {
        opacity: 0;
        transform: translateY(6px);
        transition:
          opacity 0.22s ease,
          transform 0.28s ease;
      }

      .specialty-card__reveal {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        transition:
          opacity 0.42s ease 0.14s,
          transform 0.62s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
      }
    }
  }

  @media (hover: none), (pointer: coarse) {
    .specialty-card {
      height: auto;
      min-height: 26rem;
      display: flex;
      flex-direction: column;
    }
    .specialty-card__media {
      position: relative;
      inset: auto;
      aspect-ratio: 1.08;
      height: auto;
      margin: 0.625rem 0.625rem 0 0.625rem;
      border-radius: 0.75rem;
      flex: 0 0 auto;
    }
    .specialty-card__overlay {
      display: none;
    }
    .specialty-card__reveal {
      position: relative;
      inset: auto;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .specialty-card__media,
    .specialty-card__overlay,
    .specialty-card__reveal,
    .specialty-card__media img {
      transition: none !important;
    }
  }
</style>
