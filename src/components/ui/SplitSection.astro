---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArrowButton from "./ArrowButton.astro";

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  /** Párrafos del bloque de texto. */
  paragraphs: readonly string[];
  /** Lista corta bajo los párrafos (opcional). */
  bullets?: readonly string[];
  image: ImageMetadata;
  imageAlt: string;
  /** `text-start`: la imagen va a la derecha. `media-start`: a la izquierda. */
  direction?: "text-start" | "media-start";
  tone?: "bone" | "canvas" | "soft";
  /** CTA principal, apunta al formulario de la página. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Nota al pie del bloque de texto. */
  footnote?: string;
}

const {
  id,
  eyebrow,
  title,
  paragraphs,
  bullets,
  image,
  imageAlt,
  direction = "text-start",
  tone = "bone",
  ctaLabel,
  ctaHref,
  footnote,
} = Astro.props;

const titleId = `${id ?? "split"}-title`;
---

<section
  id={id}
  class:list={["split", `split--${tone}`, { "split--media-start": direction === "media-start" }]}
  aria-labelledby={titleId}
>
  <div class="split__inner">
    <div class="split__text">
      {eyebrow && <span class="split__eyebrow">{eyebrow}</span>}
      <h2 id={titleId} class="split__title">{title}</h2>

      {paragraphs.map((paragraph) => <p class="split__text-body">{paragraph}</p>)}

      {
        bullets && bullets.length > 0 && (
          <ul class="split__bullets">
            {bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )
      }

      {ctaLabel && ctaHref && (
        <div class="split__actions">
          <ArrowButton label={ctaLabel} type="button" variant="accent" />
        </div>
      )}

      {footnote && <p class="split__footnote">{footnote}</p>}

      <slot />
    </div>

    <div class="split__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 45vw, 100vw"
        loading="lazy"
        class="split__image"
      />
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .split {
    // Sin `width: 100%`: dentro de `main` (flex column) un ancho explícito se
    // suma a los márgenes y desborda. El stretch del contenedor ya lo ajusta.
    padding-block: $space-3xl;

    @media (min-width: $bp-lg) {
      padding-block: $space-4xl;
    }
  }

  .split--bone {
    background: var(--color-surface-bone);
  }

  .split--canvas {
    background: var(--color-surface);
  }

  .split--soft {
    background: var(--color-surface-container-low);
  }

  .split__inner {
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-xl;
    align-items: center;

    @media (min-width: $bp-lg) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: $space-3xl;
      padding-inline: $gutter-desktop;
    }
  }

  .split--media-start .split__inner {
    @media (min-width: $bp-lg) {
      .split__text {
        order: 2;
      }

      .split__media {
        order: 1;
      }
    }
  }

  .split__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $space-md;
    min-width: 0;
  }

  .split__eyebrow {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .split__title {
    @include text-headline-xl;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .split__text-body {
    @include text-body-lg;
    margin: 0;
    max-width: 34rem;
    color: var(--color-on-surface-variant);

    & + & {
      margin-top: $space-md;
    }
  }

  .split__bullets {
    list-style: none;
    margin: $space-2xs 0 0;
    padding: 0;
    display: grid;
    gap: $space-sm;
    max-width: 34rem;

    li {
      display: flex;
      align-items: flex-start;
      gap: $space-sm;
      @include text-body-base;
      color: var(--color-on-surface);

      &::before {
        content: "";
        flex: 0 0 auto;
        width: 0.375rem;
        height: 0.375rem;
        margin-top: 0.55em;
        border-radius: $radius-full;
        background: var(--color-secondary);
      }
    }
  }

  .split__actions {
    margin-top: $space-sm;
  }

  .split__footnote {
    @include text-body-sm;
    margin: 0;
    max-width: 34rem;
    color: color-mix(in srgb, var(--color-on-surface-variant) 82%, transparent);
  }

  .split__media {
    position: relative;
    overflow: hidden;
    border-radius: $radius-lg;
    background: var(--color-surface-subtle);
    aspect-ratio: 4 / 3;

    @media (min-width: $bp-lg) {
      aspect-ratio: 5 / 4;
    }
  }

  .split__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>