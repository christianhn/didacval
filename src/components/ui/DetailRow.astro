---
interface Props {
  title: string;
  subtitle: string;
  bullets: readonly string[];
  linkLabel: string;
  linkHref: string;
}

const { title, subtitle, bullets, linkLabel, linkHref } = Astro.props;
---

<article class="detail-row">
  <h3 class="detail-row__title">{title}</h3>
  <span class="detail-row__subtitle">{subtitle}</span>
  <ul class="detail-row__bullets">
    {bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>
  <a class="detail-row__link" href={linkHref}>
    <span>{linkLabel}</span>
    <span class="detail-row__link-icon" aria-hidden="true">→</span>
  </a>
</article>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .detail-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: $space-lg;
    border-top: 1px dashed var(--color-outline-variant);

    @media (min-width: $bp-lg) {
      padding-block: $space-2xl;
    }

    &:last-child {
      border-bottom: 1px dashed var(--color-outline-variant);
    }
  }

  .detail-row__title {
    @include text-headline-sm;
    margin: 0;
    margin-bottom: 1rem;
    color: var(--color-on-surface);

    @media (min-width: $bp-lg) {
      @include text-headline-lg;
    }
  }

  .detail-row__subtitle {
    @include text-body-lg;
    font-weight: 500;
    color: var(--color-on-surface);
    margin-top: $space-2xs;
  }

  .detail-row__bullets {
    margin: $space-sm 0 0;
    padding-left: $space-md;
    list-style-type: disc;
    list-style-position: outside;

    li {
      @include text-body-base;
      color: var(--color-on-surface-variant);

      & + li {
        margin-top: $space-2xs;
      }

      &::marker {
        color: var(--color-secondary);
      }
    }
  }

  .detail-row__link {
    display: inline-flex;
    align-items: center;
    gap: $space-2xs;
    margin-top: $space-md;
    @include text-body-base;
    font-weight: 500;
    color: var(--color-secondary);
    text-decoration: none;
    transition: opacity 0.2s;

    &:hover {
      opacity: 0.7;
    }
  }

  .detail-row__link-icon {
    font-size: 1rem;
    line-height: 1;
  }
</style>
