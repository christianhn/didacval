---
/**
 * "Un apunte": tarjeta pequeña con icono, rótulo y texto corto.
 *
 * Vive dentro de una sección, no es una sección. Sirve para lo que no merece un
 * H3 pero sí debe verse: una aclaración, una advertencia, una condición del
 * tratamiento. Sin él, ese contenido acaba en un H3 que compite con el H2 de la
 * sección, o en un párrafo suelto que nadie lee.
 *
 * Sus medidas son las de la landing (12px de padding, radio 0.75rem, texto de
 * 14px): es el mismo componente que estaba escrito dentro de `Process.astro`, y
 * moverlo no cambia ni un píxel de la portada.
 */
export interface Note {
  text: string;
  /** Rótulo de la tarjeta. Por defecto, "Un apunte". */
  label?: string;
}

interface Props extends Note {
  class?: string;
}

const { text, label = "Un apunte", class: className } = Astro.props;
---

<aside class:list={["note-card", className]}>
  <span class="note-card__icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
  </span>

  <div class="note-card__body">
    <span class="note-card__label">{label}</span>
    <p class="note-card__text">{text}</p>
  </div>
</aside>

<style lang="scss">
  @use "../../styles/variables" as *;

  .note-card {
    display: flex;
    align-items: flex-start;
    gap: $space-md;
    padding: 1.25rem;
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant-transparent);
    border-radius: 0.75rem;
    box-shadow: 0 0.25rem 1.25rem -0.125rem rgba(0, 0, 0, 0.03);
  }

  .note-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    background: #c5c7c03d;
    color: var(--color-primary);

    svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  .note-card__body {
    display: flex;
    flex-direction: column;
    gap: $space-2xs;
    min-width: 0;
  }

  .note-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }

  .note-card__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
    margin: 0;
    text-wrap: pretty;
  }
</style>
