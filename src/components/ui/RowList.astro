---
import ListRow from "./ListRow.astro";

export interface RowListItem {
  icon?: string;
  kicker?: string;
  title: string;
  href?: string;
  subtitle?: string;
  bullets?: readonly string[];
  ctaLabel?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  /** Enlace del encabezado, a la derecha. */
  cta?: { label: string; href: string };
  items: readonly RowListItem[];
  /**
   * `panel` mete la lista en una tarjeta suave con esquinas redondeadas (el
   * tratamiento de "Áreas en detalle"); `full` la deja a sangre con líneas
   * finas. Las subpáginas alternan las dos para no repetir siempre el mismo
   * bloque.
   */
  variant?: "panel" | "full";
}

const {
  id,
  eyebrow,
  title,
  description,
  cta,
  items,
  variant = "panel",
} = Astro.props;

const titleId = `${id ?? "row-list"}-title`;
---

<section
  id={id}
  class:list={["row-list", `row-list--${variant}`]}
  aria-labelledby={titleId}
>
  <div class="row-list__inner">
    <header class="row-list__header">
      <div class="row-list__heading">
        {eyebrow && <span class="row-list__eyebrow">{eyebrow}</span>}
        <h2 id={titleId} class="row-list__title">{title}</h2>
        {description && <p class="row-list__desc">{description}</p>}
      </div>

      {
        cta && (
          <a class="row-list__cta" href={cta.href}>
            <span>{cta.label}</span>
            <span class="material-symbols-outlined" aria-hidden="true">
              north_east
            </span>
          </a>
        )
      }
    </header>

    <ul class="row-list__items">
      {items.map((item) => <ListRow {...item} />)}
    </ul>

    <slot />
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  // Sin `width: 100%`: dentro de `main` (flex column) un ancho explícito se
  // suma a los márgenes laterales y el bloque se sale por la derecha. El
  // `align-items: stretch` del contenedor ya lo ajusta al ancho disponible.
  .row-list {
    // nothing
  }

  .row-list--panel {
    margin-inline: $gutter-mobile;
    padding: $space-2xl 0 $space-lg;
    border-radius: $radius-lg;
    background: var(--color-surface-bone-dark);
    border-top: 0.0625rem solid var(--color-border-hairline);

    @media (min-width: $bp-lg) {
      margin-inline: $space-2xl;
      padding-block: $space-3xl $space-2xl;
    }
  }

  .row-list__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: $space-xl;
    padding-inline: $gutter-mobile;

    @media (min-width: $bp-lg) {
      gap: $space-2xl;
      padding-inline: $gutter-desktop;
    }
  }

  // En variante `full` el encabezado y la lista comparten los mismos gutters
  // que el resto de secciones de la web (no los de la tarjeta). El ancho máximo
  // se mantiene para que a 1440px+ el texto no se estire de más.
  .row-list--full .row-list__inner {
    padding-inline: 0;
  }

  .row-list__header {
    display: flex;
    flex-direction: column;
    gap: $space-md;

    @media (min-width: $bp-lg) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: $space-xl;
    }
  }

  .row-list--full .row-list__header,
  .row-list--full .row-list__items {
    padding-inline: $gutter-mobile;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .row-list__heading {
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    max-width: 40rem;
    min-width: 0;
  }

  .row-list__eyebrow {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .row-list__title {
    @include text-headline-xl;
    margin: 0;
    color: var(--color-on-surface);
    text-wrap: balance;
  }

  .row-list__desc {
    @include text-body-base;
    margin: 0;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
    max-width: 34rem;
  }

  .row-list__cta {
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
    flex-shrink: 0;
    align-self: flex-start;
    @include text-body-sm;
    font-weight: 600;
    color: var(--color-on-surface);
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 0.0625rem solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s;
    @include focus-ring;

    .material-symbols-outlined {
      font-size: 0.9375rem;
    }

    &:hover {
      color: var(--color-secondary);
      border-color: var(--color-secondary);
    }
  }

  .row-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 0.0625rem solid var(--color-outline-variant-transparent);
  }
</style>