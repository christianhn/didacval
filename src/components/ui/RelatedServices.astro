---
export interface RelatedLink {
  label: string;
  href: string;
  /** Una línea: por qué esa página le sirve a quien está leyendo esta. */
  description: string;
}

interface Props {
  id?: string;
  title?: string;
  links: readonly RelatedLink[];
}

const { id, title = "También te puede interesar", links } = Astro.props;
---

<nav
  id={id}
  class="related"
  aria-labelledby={id ? `${id}-title` : undefined}
  aria-label={id ? undefined : title}
>
  <span class="related__title" id={id ? `${id}-title` : undefined}>
    {title}
  </span>

  <ul class="related__list">
    {
      links.map((link) => (
        <li class="related__item">
          <a class="related__link" href={link.href}>
            <span class="related__label">{link.label}</span>
            <span class="related__desc">{link.description}</span>
            <span class="material-symbols-outlined related__icon" aria-hidden="true">
              north_east
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .related {
    display: flex;
    flex-direction: column;
    gap: $space-md;
  }

  .related__title {
    @include eyebrow(var(--color-eyebrow-accent));
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: $space-sm;
    grid-template-columns: 1fr;

    @media (min-width: $bp-sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: $bp-lg) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .related__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: $space-3xs;
    height: 100%;
    padding: $space-lg;
    border-radius: $radius-default;
    background: var(--color-surface-container-lowest);
    border: 0.0625rem solid
      color-mix(in srgb, var(--color-primary) 6%, transparent);
    transition: border-color 0.2s ease;
    @include focus-ring;

    &:hover {
      border-color: var(--color-outline);
    }
  }

  .related__label {
    @include text-body-lg;
    font-weight: 500;
    color: var(--color-on-surface);
    padding-right: $space-xl;
    text-wrap: balance;
  }

  .related__desc {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    line-height: 1.55;
  }

  .related__icon {
    position: absolute;
    top: $space-lg;
    right: $space-lg;
    font-size: 1rem;
    color: var(--color-secondary);
    transition: transform 0.25s ease;
  }

  @media (hover: hover) {
    .related__link:hover .related__icon {
      transform: translate(2px, -2px);
    }
  }

  .related__link:focus-visible .related__icon {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .related__icon {
      transition: none;
    }
  }
</style>