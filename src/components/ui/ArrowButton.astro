---
interface Props {
  label: string;
  /** Con href se renderiza como enlace; sin él, como botón. */
  href?: string;
  type?: "submit" | "button" | "reset";
  disabled?: boolean;
  class?: string;
  "aria-label"?: string;
  variant?: "primary" | "secondary" | "accent" | "on-dark";
}

const {
  label,
  href,
  type = "button",
  disabled = false,
  class: className = "",
  "aria-label": ariaLabel,
  variant = "primary",
  ...attrs
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class={`cta cta--${variant} ${className}`}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-label={ariaLabel}
  data-cta
  {...attrs}
>
  {/*
    La etiqueta no va en `aria-hidden`: es el nombre accesible del botón o del
    enlace, y sin ella el CTA no tenía nombre para el lector de pantalla
    (`button-name` / `link-name` en Lighthouse). Sólo se oculta la copia que
    se muestra durante el efecto de rodadura, que es puro adorno.
  */}
  <span class="cta__label">
    <span class="cta__clip">
      <span class="cta__stack" data-stack>
        <span class="cta__line">{label}</span>
        <span class="cta__line" aria-hidden="true">{label}</span>
      </span>
    </span>
  </span>
  <span class="cta__icon" aria-hidden="true">
    <span class="material-symbols-outlined">north_east</span>
  </span>
</Tag>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;

  .cta {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: $space-sm;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    // Se ve cientos de veces al día: el botón no se desplaza al pulsarse, sólo
    // encoge. Moverlo en `:active` añadiría retardo entre el clic y el cambio.
    transition: transform 150ms var(--ease-out-ui);

    &.cta--primary {
      .cta__label {
        background: var(--color-primary);
        color: var(--color-on-primary);
      }

      .cta__icon {
        background: var(--color-primary);
        color: var(--color-on-primary);

        .material-symbols-outlined {
          color: var(--color-on-primary);
        }
      }
    }

    &.cta--secondary {
      .cta__label {
        background: var(--color-secondary);
        color: var(--color-on-secondary);
      }

      .cta__icon {
        background: var(--color-secondary);
        color: var(--color-on-secondary);

        .material-symbols-outlined {
          color: var(--color-on-secondary);
        }
      }
    }

    &.cta--accent {
      .cta__label {
        background: var(--color-accent);
        color: var(--color-on-accent);
      }

      .cta__icon {
        background: var(--color-accent-strong);
        color: var(--color-on-accent);

        .material-symbols-outlined {
          color: var(--color-on-accent);
        }
      }
    }

    // Contraste sobre foto o vídeo oscuro (el hero). Misma forma y mismas
    // medidas que las demás variantes: sólo cambia el color, para que el rótulo
    // siga destacando contra el fondo y el círculo siga siendo de tinta.
    &.cta--on-dark {
      .cta__label {
        background: var(--color-surface-container-lowest);
        color: var(--color-primary);
      }

      .cta__icon {
        background: var(--color-primary);
        color: var(--color-on-primary);

        .material-symbols-outlined {
          color: var(--color-on-primary);
        }
      }

      // El anillo de foco por defecto es negro: sobre el vídeo se perdería.
      &:focus-visible {
        outline-color: var(--color-surface-container-lowest);
      }
    }

    // Confirmación de pulsación. `scale()` arrastra también a los hijos, así que
    // el rótulo y el icono encogen con la píldora: es lo que hace un botón
    // físico al hundirse.
    @media (prefers-reduced-motion: no-preference) {
      &:active {
        transform: scale(0.98);
      }
    }

    &:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 0.25rem;
      border-radius: $radius-full;
    }
  }

  .cta__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0 $space-lg;
    height: 2.75rem;
    border-radius: $radius-full;
    background: var(--color-primary);
    color: var(--color-on-primary);
    z-index: 1;
  }

  .cta__clip {
    position: relative;
    overflow: hidden;
    height: 1.3em;
  }

  .cta__stack {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .cta__line {
    display: block;
    height: 1.3em;
    @include text-body-base;
    line-height: 1.1375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .cta__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: $radius-full;
    background: var(--color-primary);
    color: var(--color-on-primary);
    // El círculo gira 45° al pasar por encima: 280 ms con curva propia, no los
    // 350 ms con `cubic-bezier(.65,0,.35,1)` de antes. A 350 ms el giro llegaba
    // tarde y se leía como retraso en lugar de como reacción.
    transition: transform var(--dur-panel) var(--ease-out-ui);

    .material-symbols-outlined {
      font-size: 1.125rem;
      color: var(--color-on-primary);
    }
  }

  @media (hover: hover) {
    .cta:not(:disabled):hover .cta__icon {
      transform: rotate(45deg);
    }
  }

  .cta:not(:disabled):focus-visible .cta__icon {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__icon {
      transition: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // El texto hace un rodillo (roll) de la copia de arriba a la de abajo: es la
  // única animación del CTA y se dispara en cada hover, así que va corta y sin
  // retardo. Con movimiento reducido, el rótulo no se mueve: la etiqueta sigue
  // ahí y eso es lo único que importa.
  if (!prefersReducedMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-cta]")
      .forEach((btn) => {
      const stack = btn.querySelector<HTMLElement>("[data-stack]");
      if (!stack) return;

      let animating = false;

      const roll = () => {
        if (animating) return;
        animating = true;

        const anim = stack.animate(
          [{ transform: "translateY(0)" }, { transform: "translateY(-50%)" }],
          { duration: 280, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
        );

        anim.onfinish = () => {
          animating = false;
        };
      };

      const isDisabled = () => btn instanceof HTMLButtonElement && btn.disabled;

      const isFocusVisible = () => btn.matches(":focus-visible");

      btn.addEventListener("pointerenter", (e: PointerEvent) => {
        if (e.pointerType === "mouse" && !isDisabled()) roll();
      });

      btn.addEventListener("pointerleave", (e: PointerEvent) => {
        if (e.pointerType === "mouse" && !isDisabled()) roll();
      });

      btn.addEventListener("focusin", () => {
        if (isFocusVisible() && !isDisabled()) roll();
      });

      btn.addEventListener("focusout", () => {
        if (isFocusVisible() && !isDisabled()) roll();
      });
    });
  }
</script>