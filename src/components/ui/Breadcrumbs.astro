---
import type { Crumb } from "../../data/structuredData";

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Migas de pan">
  <ol class="breadcrumbs__list">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="breadcrumbs__item">
            {isLast ? (
              <span class="breadcrumbs__current" aria-current="page">
                {item.label}
              </span>
            ) : (
              <a class="breadcrumbs__link" href={item.href}>
                {item.label}
              </a>
            )}
            {!isLast && (
              <span class="breadcrumbs__sep" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .breadcrumbs {
    padding-block: $space-md $space-sm;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $space-2xs;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: $space-2xs;
  }

  .breadcrumbs__link {
    @include text-caption-sm;
    @include focus-ring;
    color: var(--color-on-surface-variant);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-outline-variant);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;

    &:hover {
      color: var(--color-on-surface);
      text-decoration-line: underline;
      text-decoration-color: var(--color-on-surface);
    }
  }

  .breadcrumbs__sep {
    @include text-caption-sm;
    color: var(--color-outline);
  }

  .breadcrumbs__current {
    @include text-caption-sm;
    color: var(--color-on-surface);
    font-weight: 500;
  }
</style>