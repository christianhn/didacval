---
import { siteData } from "../data/site";
---

<header id="site-header" class="header header--transparent" data-header>
  <div class="header__inner">
    <div class="header__brand">
      <img class="header__logo" src={siteData.brand.logo} alt={siteData.brand.logoAlt} width="32" height="32" />
      <a class="header__brand-text" href="#inicio" data-path="inicio">
        <span class="header__brand-name">{siteData.brand.name}</span>
        <span class="header__brand-subtitle">{siteData.brand.subtitle}</span>
      </a>
    </div>

    <nav class="header__nav" aria-label="Navegación principal">
      {
        siteData.nav.map((item) => (
          <a
            class:list={["header__nav-link", { "header__nav-link--active": item.active }]}
            href={item.href}
            data-path={item.path}
            aria-current={item.active ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <a class="header__cta" href={siteData.cta.href} data-path={siteData.cta.path}>
        <span>{siteData.cta.label}</span>
        <span class="header__cta-icon" aria-hidden="true">
          <span class="material-symbols-outlined">arrow_forward</span>
        </span>
      </a>
      <div class="header__avatar" aria-hidden="true">
        <span class="material-symbols-outlined">person</span>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]") as HTMLElement | null;

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.remove("header--transparent");
      header.classList.add("header--solid");
    } else {
      header.classList.add("header--transparent");
      header.classList.remove("header--solid");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  // inicial
  onScroll();
</script>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/typography" as *;

  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: $z-header;
    transition:
      background 0.3s ease,
      backdrop-filter 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  // Estado sólido (cuando se hace scroll o sin hero video)
  .header--solid {
    background: rgba(248, 250, 245, 0.85);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid transparent;
  }

  // Estado transparente sobre el video
  .header--transparent {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .header__inner {
    height: 80px;
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $space-md;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: $space-sm;
  }

  .header__logo {
    height: 32px;
    width: auto;
    object-fit: contain;
    // sobre video oscuro, el logo quizás necesite filtro claro si es oscuro
    .header--transparent & {
      filter: brightness(0) invert(1);
    }
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
  }

  .header__brand-name {
    @include text-headline-sm;
    letter-spacing: -0.015em;
    transition: color 0.3s ease;

    .header--solid & {
      color: var(--color-on-surface);
    }
    .header--transparent & {
      color: #fff;
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    }
  }

  .header__brand-subtitle {
    @include text-caption-micro;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 9px;
    transition: color 0.3s ease;

    .header--solid & {
      color: var(--color-secondary);
    }
    .header--transparent & {
      color: rgba(255, 255, 255, 0.75);
    }
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: $space-xs;

    @media (min-width: $bp-md) {
      display: flex;
    }
  }

  .header__nav-link {
    padding: $space-2xs $space-sm;
    border-radius: $radius-full;
    @include text-body-sm;
    transition:
      color 0.3s ease,
      background 0.3s ease;

    .header--solid & {
      color: var(--color-on-surface-variant);
      &:hover {
        color: var(--color-on-surface);
      }
      &--active {
        background: var(--color-secondary-container);
        color: var(--color-on-secondary-container);
        font-weight: 500;
      }
    }

    .header--transparent & {
      color: rgba(255, 255, 255, 0.86);
      &:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
      }
      &--active {
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
        font-weight: 500;
      }
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: $space-sm;
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    padding: $space-2xs $space-2xs $space-2xs $space-lg;
    border-radius: $radius-full;
    @include text-label-pill;
    letter-spacing: 0.02em;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      opacity 0.2s,
      transform 0.15s;

    .header--solid & {
      background: var(--color-primary);
      color: var(--color-on-primary);
    }

    .header--transparent & {
      background: #fff;
      color: #0a0b0a;
    }

    &:hover {
      opacity: 0.92;
    }
    &:active {
      transform: scale(0.97);
    }
  }

  .header__cta-icon {
    width: 24px;
    height: 24px;
    margin-left: $space-xs;
    border-radius: $radius-full;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;

    .header--solid & {
      background: rgba(255, 255, 255, 0.15);
    }
    .header--transparent & {
      background: rgba(0, 0, 0, 0.08);
    }

    .material-symbols-outlined {
      font-size: 14px;
      .header--solid & {
        color: var(--color-on-primary);
      }
      .header--transparent & {
        color: #0a0b0a;
      }
    }
  }

  .header__avatar {
    width: 32px;
    height: 32px;
    border-radius: $radius-full;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.3s ease,
      color 0.3s ease;

    .header--solid & {
      background: var(--color-primary);
      .material-symbols-outlined {
        color: var(--color-on-primary);
      }
    }
    .header--transparent & {
      background: rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      .material-symbols-outlined {
        color: #fff;
      }
    }

    .material-symbols-outlined {
      font-size: 18px;
    }
  }
</style>
