---
import { bentoData } from "../data/bento";
---

<section class="bento" aria-label="Áreas clínicas destacadas">
  <div class="bento__inner">
    {
      bentoData.map((item) => (
        <article class="bento__card">
          <img class="bento__image" src={item.image} alt={item.alt} loading="lazy" />
          <div class="bento__overlay" aria-hidden="true" />
          <div class="bento__content">
            <span class="bento__kicker">{item.kicker}</span>
            <span class="bento__title">{item.title}</span>
            <span class="bento__subtitle">{item.subtitle}</span>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/typography" as *;

  .bento {
    width: 100%;
    background: var(--color-surface);
    padding: 0 $gutter-mobile $space-2xl;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .bento__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-sm;

    @media (min-width: 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
    @media (min-width: $bp-lg) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bento__card {
    position: relative;
    overflow: hidden;
    border-radius: $radius-default;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: $space-md;
    background: var(--color-surface-container-high);
    isolation: isolate;

    &:hover .bento__image {
      transform: scale(1.05);
    }
  }

  .bento__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
    z-index: -1;
  }

  .bento__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 11, 10, 0.85), rgba(10, 11, 10, 0.2) 60%, transparent);
    z-index: 0;
  }

  .bento__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bento__kicker {
    @include text-caption-micro;
    color: var(--color-warm-sand);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bento__title {
    @include text-headline-sm;
    color: var(--color-on-secondary);
    line-height: 1.2;
  }

  .bento__subtitle {
    @include text-index-item;
    color: var(--color-primary-fixed-dim);
  }
</style>
