---
import { specialtiesData } from "../data/specialties";
import SpecialtyCard from "./SpecialtyCard.astro";
---

<section
  id="areas-clinicas"
  class="specialties"
  aria-labelledby="specialties-title"
>
  <div class="specialties__inner">
    <header class="specialties__header">
      <div class="specialties__heading">
        <span class="specialties__eyebrow">{specialtiesData.eyebrow}</span>
        <h2 id="specialties-title" class="specialties__title">
          {specialtiesData.title}
        </h2>
        <p class="specialties__desc">{specialtiesData.description}</p>
      </div>
      <a class="specialties__header-cta" href={specialtiesData.headerCta.href}>
        <span>{specialtiesData.headerCta.label}</span>
        <span class="specialties__header-cta-icon" aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="specialties__grid">
      {
        specialtiesData.cards.map((card) => (
          <SpecialtyCard
            image={card.image}
            imageAlt={card.imageAlt}
            title={card.title}
            kicker={card.kicker}
            description={card.description}
            cta={card.cta}
          />
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/typography" as *;

  $ink: #191c1a;
  $muted: #5a5e5b;
  $accent: #6e8276;

  .specialties {
    width: 100%;
    background: #f4f3f1;
    padding: 3rem $gutter-mobile 3.5rem;

    @media (min-width: $bp-lg) {
      padding: 4.5rem $gutter-desktop 4.5rem;
    }
  }

  .specialties__inner {
    max-width: $container-max;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;

    @media (min-width: $bp-lg) {
      gap: 2.5rem;
    }
  }

  .specialties__header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    @media (min-width: $bp-lg) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .specialties__heading {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 36rem;
  }

  .specialties__eyebrow {
    @include text-caption-micro;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: $accent;
    font-weight: 600;
    font-size: 0.625rem;
  }

  .specialties__title {
    margin: 0;
    color: $ink;
    font-family: $font-family-base;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 600;

    @media (min-width: $bp-md) {
      font-size: 2.75rem;
    }
    @media (min-width: $bp-lg) {
      font-size: 3.25rem;
      letter-spacing: -0.04em;
    }
  }

  .specialties__desc {
    margin: 0.25rem 0 0;
    @include text-body-sm;
    color: $muted;
    line-height: 1.5;
    max-width: 30rem;
    font-size: 0.8125rem;

    @media (min-width: $bp-lg) {
      font-size: 0.875rem;
    }
  }

  .specialties__header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    font-family: $font-family-base;
    font-size: 0.8125rem;
    font-weight: 600;
    color: $ink;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition:
      opacity 0.2s,
      border-color 0.2s;

    &:hover {
      opacity: 0.7;
      border-color: $ink;
    }
  }

  .specialties__header-cta-icon {
    font-size: 0.85rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .specialties__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;

    @media (min-width: $bp-sm) {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    @media (min-width: $bp-lg) {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
  }
</style>
