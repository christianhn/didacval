---
import { heroData } from "../data/hero";
import natureVideo from "../assets/hero/nature.mp4";
---

<section class="hero-video" aria-labelledby="hero-title">
  <video
    class="hero-video__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src={natureVideo} type="video/mp4" />
  </video>

  <!-- Overlay para legibilidad -->
  <div class="hero-video__overlay" aria-hidden="true"></div>
  <div class="hero-video__vignette" aria-hidden="true"></div>

  <div class="hero-video__content">
    <div class="hero-video__text">
      <h1 id="hero-title" class="hero-video__title">
        {heroData.title.line1}
        <span class="hero-video__title-accent">{heroData.title.line2}</span>
      </h1>
    </div>
  </div>

  <!-- Indicador scroll sutil -->
  <a class="hero-video__scroll" href="#intro" aria-label="Descubrir más">
    <span>Descubre</span>
    <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/typography" as *;

  .hero-video {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 560px;
    max-height: 920px;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    background: var(--color-surface-dark);
  }

  .hero-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
  }

  .hero-video__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    // degradado lateral izquierda para texto + superior para header transparente
    background:
      linear-gradient(
        90deg,
        rgba(10, 11, 10, 0.72) 0%,
        rgba(10, 11, 10, 0.55) 36%,
        rgba(10, 11, 10, 0.18) 68%,
        rgba(10, 11, 10, 0.06) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 11, 10, 0.38) 0%,
        rgba(10, 11, 10, 0) 28%,
        rgba(10, 11, 10, 0.22) 100%
      );
  }

  .hero-video__vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at center, transparent 56%, rgba(0, 0, 0, 0.22) 100%);
    pointer-events: none;
  }

  .hero-video__content {
    width: 100%;
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    padding-top: 80px; // compensa header fixed
    // centrado vertical, alineado a la izquierda
    display: flex;
    align-items: center;
    min-height: 100vh;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .hero-video__text {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: $space-md;
  }

  .hero-video__title {
    @include text-display-hero;
    color: #fff;
    margin: 0;
    text-wrap: balance;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);

    @media (max-width: 768px) {
      font-size: 40px;
      line-height: 42px;
    }

    @media (max-width: 480px) {
      font-size: 32px;
      line-height: 34px;
    }
  }

  .hero-video__title-accent {
    display: block;
    font-style: italic;
    font-weight: 300;
    color: var(--color-warm-sand);
    margin-top: 0.12em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-video__scroll {
    position: absolute;
    left: 50%;
    bottom: $space-lg;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: rgba(255, 255, 255, 0.9);
    @include text-caption-micro;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 1;
    }

    .material-symbols-outlined {
      font-size: 18px;
      animation: hero-bounce 1.6s ease-in-out infinite;
    }
  }

  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(4px);
      opacity: 0.85;
    }
  }

  // Respeta usuarios con reduced motion
  @media (prefers-reduced-motion: reduce) {
    .hero-video__media {
      // no autoplay effect, but keep muted
    }
    .hero-video__scroll .material-symbols-outlined {
      animation: none;
    }
  }
</style>
