---
import { footerData } from "../../data/footer";

const currentYear = new Date().getFullYear();

const breakable = (s: string) => s.split(/(?<=@|\.)/);
---

<footer class="footer" data-footer>
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__desc">
        <p class="footer__desc-text">{footerData.brand.description}</p>
        <div class="footer__desc-status">
          <span class="footer__dot" aria-hidden="true"></span>
          <span>{footerData.brand.status}</span>
        </div>
      </div>

      <div class="footer__col">
        <span class="footer__col-title">{footerData.contact.title}</span>
        <p class="footer__address">
          {footerData.contact.address[0]}<br />{footerData.contact.address[1]}
        </p>
        <a
          class="footer__link footer__link--strong"
          href={footerData.contact.phone.href}
          >{footerData.contact.phone.label}</a
        >
        <a
          class="footer__link footer__link--strong"
          href={footerData.contact.email.href}
          >{
            breakable(footerData.contact.email.label).map((chunk) => (
              <>
                {chunk}
                <wbr />
              </>
            ))
          }</a
        >
      </div>

      <div class="footer__col">
        <span class="footer__col-title">{footerData.links.title}</span>
        {
          footerData.links.items.map((item) => (
            <a class="footer__link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="footer__col">
        <span class="footer__col-title">{footerData.legal.title}</span>
        <span class="footer__text">
          {footerData.legal.collegiate[0]}<br />{footerData.legal.collegiate[1]}
        </span>
        <span class="footer__note">{footerData.legal.note}</span>
      </div>
    </div>

    <div class="footer__brand">
      <!--
        La wordmark gigante es decorativa: repite el nombre de marca, que ya
        aparece en el header y en el title. Se marca como tal para no duplicar
        el nombre ante un lector de pantalla. El contraste bajo que tiene es
        deliberado (es una marca de agua, no un texto) y está anotado en el
        informe de entrega.
      -->
      <span class="footer__brand-name" aria-hidden="true"
        >{footerData.brand.name}</span
      >
    </div>

    <div class="footer__bottom">
      <span class="footer__copyright"
        >© {currentYear} Didac Val Psicólogo. Todos los derechos reservados.</span
      >
      <nav class="footer__legal-nav" aria-label="Legal">
        {
          footerData.bottom.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { prefersReducedMotion } from "../../scripts/motion";

  gsap.registerPlugin(ScrollTrigger);

  const FOOTER_VIEWPORT_RATIO = 2 / 3;
  const PEEK_RATIO = 0.2;
  const PEEK_END = PEEK_RATIO / (1 + PEEK_RATIO);
  const END = 1 / (1 + PEEK_RATIO);
  const LIFT = END - PEEK_END;
  const LEAD_RATIO = 0.3;

  const footer = document.querySelector<HTMLElement>("[data-footer]");
  const contact = document.querySelector<HTMLElement>(".contact");
  const contactInner = contact?.querySelector<HTMLElement>(".contact__inner");
  const dim = document.querySelector<HTMLElement>("[data-contact-dim]");
  const footerInner = footer?.querySelector<HTMLElement>(".footer__inner");

  // El footer pineado se ancla al viewport, así que sólo funciona si el bloque de
  // contacto es lo último de `main`: cualquier sección posterior (los datos de
  // contacto de /contacto/, por ejemplo) acabaría tapada detrás de él. Cuando no
  // se cumple, el footer se queda en su sitio, dentro del flujo normal, que es
  // justo lo que quiere una página sin ese bloque final.
  const main = document.querySelector<HTMLElement>("main");
  const contactIsLast =
    !!contact && !!main && main.lastElementChild === contact;

  const canAnimate =
    !!footer &&
    contactIsLast &&
    !!contactInner &&
    !!dim &&
    !!footerInner &&
    !prefersReducedMotion();

  if (footer && contact && contactInner && dim && footerInner && canAnimate) {
    const applyHeight = () => {
      const viewport = window.innerHeight;

      footer.style.height = "auto";
      footerInner.style.height = "auto";

      const content = footerInner.getBoundingClientRect().height;
      const target = Math.min(
        viewport,
        Math.max(viewport * FOOTER_VIEWPORT_RATIO, content),
      );

      footer.style.height = `${target}px`;

      contact.style.paddingBottom = `${footer.offsetHeight * (1 + LEAD_RATIO)}px`;
    };

    const revealTargets = footer.querySelectorAll(
      ".footer__desc-text, .footer__desc-status, .footer__col, .footer__brand, .footer__bottom",
    );

    footer.classList.add("footer--fixed");
    applyHeight();
    gsap.set(footer, { yPercent: 100 });
    gsap.set(revealTargets, { yPercent: 14, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: contactInner,
        start: () => `bottom bottom-=${footer.offsetHeight * LEAD_RATIO}`,
        end: () => "+=" + footer.offsetHeight,
        scrub: true,
      },
    });

    tl.fromTo(
      footer,
      { yPercent: 100 },
      {
        yPercent: 100 - PEEK_RATIO * 100,
        duration: PEEK_END,
        ease: "none",
      },
      0,
    );

    tl.fromTo(
      footer,
      { yPercent: 100 - PEEK_RATIO * 100 },
      {
        yPercent: 0,
        duration: LIFT,
        ease: "power2.out",
        immediateRender: false,
      },
      PEEK_END,
    )
      .fromTo(
        dim,
        { opacity: 0 },
        {
          opacity: 1,
          duration: LIFT * 0.55,
          ease: "power1.out",
          immediateRender: false,
        },
        PEEK_END,
      )
      .fromTo(
        revealTargets,
        { yPercent: 14, opacity: 0 },
        {
          yPercent: 0,
          opacity: 1,
          duration: LIFT * 0.5,
          ease: "power2.out",
          stagger: 0.05,
          immediateRender: false,
        },
        PEEK_END,
      );

    const refresh = () => {
      applyHeight();
      ScrollTrigger.refresh();
    };

    let refreshTimer: number;
    const scheduleRefresh = () => {
      clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(refresh, 200);
    };

    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      scheduleRefresh();
    });
    document.fonts?.ready.then(scheduleRefresh);

    window.addEventListener("load", refresh, { once: true });
  }
</script>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  @mixin footer-label {
    @include text-caption-sm;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    // `--color-eyebrow-accent` y no `--color-on-secondary-container`: el
    // segundo daba 3.1:1 sobre el fondo claro del pie, por debajo del 4.5:1
    // que pide AA para texto pequeño. Es el mismo verde que ya usan los
    // eyebrows de las secciones.
    color: var(--color-eyebrow-accent);
  }

  .footer {
    position: relative;
    z-index: $z-footer;
    width: 100%;
    background: var(--color-surface-container-low);
    box-shadow: 0 0.0625rem 0.5rem
      color-mix(in srgb, var(--color-primary) 4%, transparent);
  }

  .footer--fixed {
    position: fixed;
    inset: auto 0 0 0;
    height: 66.6667svh;
    max-height: 100svh;
    overflow: hidden;
    will-change: transform;
  }

  .footer--fixed .footer__inner {
    padding-block-start: $space-xl;

    @media (min-width: $bp-md) {
      padding-block-start: clamp($space-xl, 8svh, $space-2xl);
    }
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    max-width: $container-max;
    width: 100%;
    height: 100%;
    margin-inline: auto;
    padding: $space-lg $gutter-mobile;
    overflow: hidden;

    @media (min-width: $bp-md) {
      padding-block: clamp($space-xl, 8svh, $space-3xl);
    }

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: $space-xl $space-md;
    margin-bottom: $space-lg;
    flex-shrink: 0;

    @media (min-width: $bp-md) {
      grid-template-columns: repeat(12, 1fr);
      gap: $space-xl;
      margin-bottom: 0;
    }
  }

  .footer__desc {
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    grid-column: 1 / -1;

    @media (min-width: $bp-md) {
      gap: $space-sm;
      grid-column: span 4;
    }
  }

  .footer__brand {
    container-type: inline-size;
    flex-shrink: 0;
    margin-top: $space-sm;
    padding-block-start: $space-sm;

    @media (min-width: $bp-md) {
      margin-top: auto;
      padding-block-start: $space-2xl;
    }
  }

  .footer__brand-name {
    @include text-headline-sm;
    display: block;
    font-size: min(17cqi, 40svh);
    line-height: 0.82;
    letter-spacing: -0.035em;
    word-spacing: -0.5rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-secondary) 25%, transparent);
    margin-left: -0.075em;
    font-weight: 400;
    @supports (text-fit: grow) {
      text-fit: grow;
    }

    @media (min-width: $bp-md) {
      font-size: min(25cqi, 40svh);
    }
  }

  .footer__desc-text {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    max-width: 22rem;
    margin: 0;
  }

  .footer__desc-status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.375rem;
    padding-top: $space-xs;
    @include footer-label;
    color: var(--color-on-surface-variant);
  }

  .footer__dot {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success);
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__dot {
      animation: none;
    }
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: $space-2xs;
    min-width: 0;
    max-width: 13rem;
    overflow-wrap: break-word;

    @media (min-width: $bp-md) {
      gap: $space-xs;
      max-width: none;

      &:nth-child(2) {
        grid-column: span 3;
      }
      &:nth-child(3) {
        grid-column: span 3;
      }
      &:nth-child(4) {
        grid-column: span 2;
      }
    }
  }

  .footer__col-title {
    @include footer-label;
    margin-bottom: $space-2xs;

    @media (min-width: $bp-md) {
      margin-bottom: $space-xs;
    }
  }

  .footer__address,
  .footer__text {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .footer__link {
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    // Interlineado de 1.5rem (24px) en vez del de `text-body-sm` (19px): los
    // enlaces del pie iban pegados entre sí y el área pulsable quedaba por
    // debajo del mínimo de 24px que exigen WCAG 2.2 y Lighthouse.
    line-height: 1.5rem;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-outline-variant);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
    @include focus-ring;

    &:hover {
      color: var(--color-on-surface);
      text-decoration-line: underline;
      text-decoration-color: var(--color-on-surface);
    }

    &--strong {
      color: var(--color-on-surface);

      &:hover {
        color: var(--color-eyebrow-accent);
        text-decoration-color: var(--color-eyebrow-accent);
      }
    }
  }

  .footer__note {
    @include text-body-sm;
    color: color-mix(in srgb, var(--color-on-surface-variant) 80%, transparent);
    margin-top: $space-2xs;
  }

  .footer__bottom {
    flex-shrink: 0;
    margin-top: $space-xs;
    padding-top: $space-md;
    border-top: 0.0625rem solid var(--color-outline-variant);
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    align-items: center;

    @media (min-width: $bp-md) {
      padding-top: $space-lg;
      gap: $space-sm;
    }

    @media (min-width: $bp-sm) {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .footer__copyright {
    @include text-caption-sm;
    color: color-mix(in srgb, var(--color-on-surface-variant) 82%, transparent);
  }

  .footer__legal-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: $space-md;
    @include text-caption-sm;
    color: color-mix(in srgb, var(--color-on-surface-variant) 82%, transparent);

    @media (min-width: $bp-md) {
      gap: $space-lg;
    }

    a {
      padding-block: $space-2xs;
      margin-block: -$space-2xs;
      text-underline-offset: 0.2em;
      text-decoration-color: var(--color-outline-variant);
      transition:
        color 0.2s,
        text-decoration-color 0.2s;
      @include focus-ring;

      &:hover {
        color: var(--color-on-surface);
        text-decoration-color: var(--color-on-surface);
      }
    }
  }

  @media (max-height: 34rem) {
    .footer--fixed .footer__inner {
      padding-block: $space-md;
    }

    .footer__grid {
      gap: $space-md;
      margin-bottom: 0;
    }

    .footer__brand {
      margin-top: $space-xs;
      padding-block-start: $space-xs;
    }

    .footer__brand-name {
      font-size: min(12cqi, 22svh);
    }

    .footer__bottom {
      padding-top: $space-sm;
    }
  }
</style>
