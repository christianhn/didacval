---
import { Image } from "astro:assets";
import {
  siteData,
  resolveNavHref,
  isActiveNavItem,
  isActiveNavChild,
} from "../../data/site";
import MobileMenu from "../ui/MobileMenu.astro";

const isHome = Astro.url.pathname === "/";
const nav = siteData.nav.map((item) => ({
  ...item,
  href: resolveNavHref(item.href, isHome),
  active: isActiveNavItem(item, Astro.url.pathname),
  children: item.children?.map((child) => ({
    ...child,
    active: isActiveNavChild(child.href, Astro.url.pathname),
  })),
}));

const specialties = nav.find((item) => item.children);
---

<header id="site-header" class="header header--transparent" data-header>
  <div class="header__inner">
    <div class="header__brand">
      <!-- <Image
        src={siteData.brand.logo}
        alt={siteData.brand.logoAlt}
        widths={[32, 64]}
        sizes="32px"
        class="header__logo"
        loading="eager"
        decoding="sync"
      /> -->
      <a class="header__brand-text" href="/" data-path="inicio">
        <span class="header__brand-name">{siteData.brand.name}</span>
      </a>
    </div>

    <div class="header__actions">
      <nav class="header__nav" aria-label="Navegación principal">
        {
          nav.map((item) =>
            item.children ? (
              // Desplegable de especialidades. En CSS hover + :focus-within, así
              // que se abre con teclado además de con ratón.
              <div class="header__group" data-nav-group>
                <a
                  class:list={[
                    "header__nav-link",
                    "header__nav-link--has-children",
                    { "header__nav-link--active": item.active },
                  ]}
                  href={item.href}
                  data-path={item.path}
                  aria-current={item.active ? "page" : undefined}
                  aria-haspopup="true"
                  aria-expanded="false"
                  data-group-trigger
                >
                  <span>{item.label}</span>
                  <span
                    class="material-symbols-outlined header__group-caret"
                    aria-hidden="true"
                  >
                    expand_more
                  </span>
                </a>

                <div class="header__group-panel" data-group-panel>
                  <ul class="header__group-list">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class:list={[
                            "header__group-link",
                            { "header__group-link--active": child.active },
                          ]}
                          href={child.href}
                          data-path={child.path}
                          aria-current={child.active ? "page" : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                class:list={[
                  "header__nav-link",
                  { "header__nav-link--active": item.active },
                ]}
                href={item.href}
                data-path={item.path}
                aria-current={item.active ? "page" : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>
      <a
        class="header__cta"
        href={resolveNavHref(siteData.cta.href, isHome)}
        data-path={siteData.cta.path}
      >
        <span>{siteData.cta.label}</span>
        <span class="header__cta-icon" aria-hidden="true">
          <span class="material-symbols-outlined">north_east</span>
        </span>
      </a>
      <button
        class="header__menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-trigger
      >
        <span>{siteData.menu.triggerLabel}</span>
        <span class="header__menu-trigger-icon" aria-hidden="true">
          <span class="material-symbols-outlined">add</span>
        </span>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  import gsap from "gsap";
  import { prefersReducedMotion } from "../../scripts/motion";

  const reducedMotion = prefersReducedMotion();

  const header = document.querySelector("[data-header]") as HTMLElement | null;
  const hero = document.querySelector(".hero-video") as HTMLElement | null;

  if (!header) {
  } else {
    const setHeaderState = (isOverHero: boolean) => {
      header.classList.toggle("header--transparent", isOverHero);
      header.classList.toggle("header--solid", !isOverHero);
    };

    if (!hero) {
      setHeaderState(false);
    } else {
      const update = () => {
        const heroBottom = hero.getBoundingClientRect().bottom;
        const headerHeight = header.offsetHeight;
        const isOverHero = heroBottom > headerHeight;
        setHeaderState(isOverHero);
      };

      if ("IntersectionObserver" in window) {
        let observer: IntersectionObserver | null = null;

        const createObserver = () => {
          if (observer) observer.disconnect();
          observer = new IntersectionObserver(
            ([entry]) => setHeaderState(entry.isIntersecting),
            {
              root: null,
              rootMargin: `-${header.offsetHeight}px 0px 0px 0px`,
              threshold: 0,
            },
          );
          observer.observe(hero);
        };

        createObserver();

        let resizeTimer: number;
        let lastWidth = window.innerWidth;
        window.addEventListener("resize", () => {
          // Plegar la barra en móvil cambia el alto, no el ancho. Reconstruir el
          // observer por eso solo añade trabajo en plena inercia.
          if (window.innerWidth === lastWidth) return;
          lastWidth = window.innerWidth;

          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            createObserver();
            update();
          }, 100) as unknown as number;
        });

        update();
      } else {
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      }
    }

    // Arranca oculto arriba del todo (progress 0). Lo usa tanto la entrada inicial
    // como el show/hide al hacer scroll.
    const showAnim = gsap
      .from(header, {
        yPercent: -100,
        paused: true,
        duration: 0.6,
        ease: "power3.out",
      })
      .progress(0);

    // La visibilidad se resuelve de forma síncrona, no dentro del temporizador
    // de entrada: el CSS oculta el header mientras `scripting` esté activo, así
    // que si ese temporizador no llegara a dispararse (ticker de GSAP en segundo
    // plano, pestaña en background, reduce-motion mal informado) el header se
    // quedaba invisible y la página se quedaba sin navegación. Mostrarlo aquí
    // no produce destello: el transform ya está a -100%.
    header.style.visibility = "visible";

    let direction = 1;
    // Hasta que pasa la entrada inicial el scroll no toca el header: si no,
    // el primer evento de scroll de Lenis lo adelantaría.
    let settled = false;
    // Estado visual en el que ya estamos. Sin esto, cada evento de scroll
    // reiniciaba el tween de 0.6s y el header no arrive a asentar nunca
    // durante la inercia (peor en iOS, donde el scroll dispara muy seguido).
    let shown = true;

    // Con movimiento reducido no hay entrada animada: el header se pinta ya en
    // su sitio final y el show/hide por scroll pasa a ser un cambio de estado
    // instantáneo. Se resuelve aquí, después de declarar `settled`: si se
    // hiciera antes, la asignación caería en zona temporal muerta.
    if (reducedMotion) {
      showAnim.progress(1).pause();
      settled = true;
    }

    const updateHeader = () => {
      if (!settled) return;

      const next = direction === -1;

      if (next === shown) return;
      shown = next;

      if (reducedMotion) {
        // Sin transición: al estado final directamente.
        header.style.transform = next ? "translateY(0)" : "translateY(-100%)";
        return;
      }

      next ? showAnim.play() : showAnim.reverse();
    };

    let lastScrollY = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        if (y !== lastScrollY) direction = y < lastScrollY ? -1 : 1;
        lastScrollY = y;
        updateHeader();
      },
      { passive: true },
    );

    // Entrada: el header baja desde arriba un poco después del primer paint,
    // para que no compita con el arranque del titular del hero.
    //
    // `setTimeout` y no `gsap.delayedCall`: el ticker de GSAP se pausa cuando
    // la pestaña no está en primer plano y su callback depende de él, mientras
    // que este temporizador se cumple siempre. La animación que dispara es la
    // misma de GSAP; sólo cambia quién le da al pulsador de inicio.
    if (!reducedMotion) {
      window.setTimeout(() => {
        showAnim.play();
        settled = true;
        updateHeader();
      }, 200);
    }

    // ---------- Desplegable de especialidades ----------
    // El CSS ya abre el panel con hover y con :focus-within. Este script cubre
    // el resto: teclado (Enter/Espacio sobre el disparador) y el toque en
    // dispositivos sin hover fino, donde no hay forma de llegar con el ratón.
    const groups = Array.from(
      document.querySelectorAll<HTMLElement>("[data-nav-group]"),
    );

    const closeGroups = (except?: HTMLElement) => {
      groups.forEach((group) => {
        if (group === except) return;
        group.removeAttribute("data-open");
        group
          .querySelector<HTMLElement>("[data-group-trigger]")
          ?.setAttribute("aria-expanded", "false");
      });
    };

    groups.forEach((group) => {
      const trigger = group.querySelector<HTMLElement>("[data-group-trigger]");
      if (!trigger) return;

      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        const isOpen = group.dataset.open === "true";
        closeGroups(group);
        if (isOpen) {
          group.removeAttribute("data-open");
          trigger.setAttribute("aria-expanded", "false");
        } else {
          group.dataset.open = "true";
          trigger.setAttribute("aria-expanded", "true");
        }
      });

      // `pointerdown` en el documento para que el clic fuera del panel lo
      // cierre sin esperar al evento `click`, que puede perderse si el dedo
      // se levanta sobre otro elemento.
      document.addEventListener("pointerdown", (event) => {
        if (group.dataset.open !== "true") return;
        if (group.contains(event.target as Node)) return;
        closeGroups();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || group.dataset.open !== "true") return;
        group.removeAttribute("data-open");
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      });
    });
  }
</script>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/typography" as *;
  @use "../../styles/mixins" as *;

  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: $z-header;
    // El header se transforma en cada frame de scroll. Sin capa propia, Safari
    // lo repinta (y vuelve a difuminar lo que tiene detrás) cada vez.
    will-change: transform;
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  // `backdrop-filter` sobre un elemento fijo y en movimiento obliga a recomponer
  // el desenfoque en cada frame. En iOS eso hunde el scroll, así que solo se
  // aplica donde hay puntero fino; en táctil el fondo va más opaco para compensar.
  @media (hover: hover) and (pointer: fine) {
    .header {
      transition:
        background 0.3s ease,
        backdrop-filter 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }
  }

  // El módulo con GSAP llega después del primer paint: sin esto el header se
  // vería quieto un instante antes de empezar a bajar.
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    [data-header] {
      visibility: hidden;
    }
  }

  .header--solid {
    background: color-mix(
      in srgb,
      var(--color-surface-bright) 92%,
      transparent
    );

    @media (hover: hover) and (pointer: fine) {
      background: color-mix(
        in srgb,
        var(--color-surface-bright) 85%,
        transparent
      );
    }

    backdrop-filter: blur(0.75rem);
    box-shadow: 0 0.0625rem 0.5rem
      color-mix(in srgb, var(--color-primary) 4%, transparent);
  }

  .header--transparent {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }

  .header__inner {
    height: 5rem;
    max-width: $container-max;
    margin-inline: auto;
    padding-inline: $gutter-mobile;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $space-md;

    @media (min-width: $bp-lg) {
      padding-inline: $gutter-desktop;
    }
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: $space-sm;
  }

  .header__logo {
    height: 1.5rem;
    width: auto;
    object-fit: contain;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
  }

  .header__brand-name {
    @include text-headline-sm;
    letter-spacing: -0.015em;
    font-family: $font-family-title;
    font-size: 1.6rem;
    white-space: nowrap;
    transition: color 0.3s ease;

    .header--solid & {
      color: var(--color-on-surface);
    }
    .header--transparent & {
      color: var(--color-surface-container-lowest);
    }
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: $space-xs;

    @media (min-width: $bp-nav) {
      display: flex;
      gap: $space-3xs;
    }

    @media (min-width: $bp-xl) {
      gap: $space-xs;
    }
  }

  // Tamaño compacto del nav entre 1024 y 1280 px, donde seis entradas más el
  // CTA no entran con la medida de escritorio. A partir de $bp-xl se recupera.
  @media (min-width: $bp-nav) and (max-width: #{$bp-xl - 0.0625rem}) {
    .header__nav-link {
      padding: $space-2xs $space-xs;
      @include text-caption-sm;
    }

    .header__cta {
      padding-left: $space-md;
      @include text-caption-sm;
    }

    .header__cta-icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .header__brand-name {
      font-size: 1.125rem;
      line-height: 1.25rem;
    }
  }

  // ---------- Desplegable de especialidades ----------
  // El nav de escritorio sólo aparece a partir de $bp-md, pero con seis
  // entradas más el desplegable se apelmaza mucho antes de $bp-lg. A partir de
  // $bp-xl el rótulo largo ("Preguntas frecuentes") tampoco cabe: se acorta.
  .header__group {
    position: relative;
  }

  .header__nav-link--has-children {
    display: inline-flex;
    align-items: center;
    gap: $space-3xs;
  }

  .header__group-caret {
    font-size: 1rem;
    line-height: 1;
    opacity: 0.7;
    transition: transform 0.25s ease;
  }

  .header__group-panel {
    position: absolute;
    top: calc(100% + $space-xs);
    left: 50%;
    z-index: 1;
    min-width: 15rem;
    padding: $space-2xs;
    border-radius: $radius-default;
    background: var(--color-surface-container-lowest);
    border: 0.0625rem solid
      color-mix(in srgb, var(--color-primary) 8%, transparent);
    box-shadow: 0 0.75rem 1.5rem
      color-mix(in srgb, var(--color-primary) 8%, transparent);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -0.375rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;

    @media (hover: hover) {
      .header__group:hover &,
      .header__group:focus-within & {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
      }
    }
  }

  // Sin hover fino (teclado, táctil que sí llega al breakpoint) el panel se
  // abre con el estado `data-open`, que pone el script al pulsar el disparador.
  .header__group[data-open="true"] .header__group-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .header__group[data-open="true"] .header__group-caret {
    transform: rotate(180deg);
  }

  .header__group-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .header__group-link {
    display: block;
    padding: $space-xs $space-sm;
    border-radius: $radius-default;
    @include text-body-sm;
    color: var(--color-on-surface-variant);
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background 0.2s ease;
    @include focus-ring;

    &:hover {
      color: var(--color-on-surface);
      background: var(--color-surface-container-low);
    }

    &--active {
      color: var(--color-secondary);
      background: var(--color-secondary-container);
      font-weight: 500;
    }
  }

  .header__nav-link {
    padding: $space-2xs $space-sm;
    border-radius: $radius-full;
    @include text-body-sm;
    transition:
      color 0.3s ease,
      background 0.3s ease;

    .header--solid & {
      color: var(--color-on-surface-variant);
      &:hover {
        color: var(--color-on-surface);
      }
      &--active {
        // `--color-secondary` (y no el verde claro de la píldora) para no
        // bajar de 4.5:1 en texto de 13px.
        color: var(--color-secondary);
        background: var(--color-secondary-container);
        font-weight: 500;
      }
    }

    .header--transparent & {
      color: color-mix(
        in srgb,
        var(--color-surface-container-lowest) 86%,
        transparent
      );
      &:hover {
        color: var(--color-surface-container-lowest);
        background: color-mix(
          in srgb,
          var(--color-surface-container-lowest) 10%,
          transparent
        );
      }
      &--active {
        background: color-mix(
          in srgb,
          var(--color-surface-container-lowest) 16%,
          transparent
        );
        color: var(--color-surface-container-lowest);
        font-weight: 500;
      }
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: $space-sm;
  }

  // Por debajo de $bp-nav el CTA no cabe junto a la marca y se traslada al
  // final del menú lateral.
  .header__cta {
    display: none;
    align-items: center;
    padding: $space-2xs $space-2xs $space-2xs $space-lg;
    border-radius: $radius-full;
    @include text-label-pill;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.15s;

    @media (min-width: $bp-nav) {
      display: inline-flex;
    }

    .header--solid & {
      background: var(--color-primary);
      color: var(--color-on-primary);

      &:hover {
        background: var(--color-accent-strong);
      }
    }

    .header--transparent & {
      color: black;
      background: white;

      &:hover {
        background: var(--color-surface-variant);
      }
    }

    &:active {
      transform: scale(0.97);
    }
  }

  .header__cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: $space-xs;
    border-radius: $radius-full;
    transition:
      background 0.3s ease,
      transform 350ms cubic-bezier(0.65, 0, 0.35, 1);

    .header--solid & {
      background: color-mix(
        in srgb,
        var(--color-surface-container-lowest) 15%,
        transparent
      );
    }
    .header--transparent & {
      background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    }

    .material-symbols-outlined {
      font-size: 0.875rem;
      .header--solid & {
        color: var(--color-on-primary);
      }
      .header--transparent & {
        color: var(--color-surface-dark);
      }
    }
  }

  @media (hover: hover) {
    .header__cta:hover .header__cta-icon {
      transform: rotate(45deg);
    }
  }

  .header__cta:focus-visible .header__cta-icon {
    transform: rotate(45deg);
  }

  // Disparador del menú lateral. Solo en móvil; comparte la píldora del nav de
  // escritorio para que el cambio de formato no mueva la marca de sitio.
  .header__menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    padding: $space-2xs $space-xs $space-2xs $space-lg;
    border: none;
    border-radius: $radius-full;
    @include text-label-pill;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      transform 0.15s;

    @media (min-width: $bp-nav) {
      display: none;
    }

    .header--solid & {
      color: var(--color-on-surface-variant);
      background: color-mix(in srgb, var(--color-on-surface) 6%, transparent);

      &:hover {
        color: var(--color-on-surface);
        background: color-mix(
          in srgb,
          var(--color-on-surface) 12%,
          transparent
        );
      }
    }

    .header--transparent & {
      color: color-mix(
        in srgb,
        var(--color-surface-container-lowest) 92%,
        transparent
      );
      background: color-mix(
        in srgb,
        var(--color-surface-container-lowest) 16%,
        transparent
      );

      &:hover {
        background: color-mix(
          in srgb,
          var(--color-surface-container-lowest) 24%,
          transparent
        );
      }
    }

    &:active {
      transform: scale(0.97);
    }
  }

  .header__menu-trigger-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    // El "+" gira 135º y se convierte en aspa: es la misma señal que da el
    // botón de cerrar del panel.
    transition: transform 350ms cubic-bezier(0.65, 0, 0.35, 1);

    .material-symbols-outlined {
      font-size: 0.875rem;
    }
  }

  .header__menu-trigger[aria-expanded="true"] .header__menu-trigger-icon,
  .header__menu-trigger:focus-visible .header__menu-trigger-icon {
    transform: rotate(135deg);
  }

  @media (hover: hover) {
    .header__menu-trigger:hover .header__menu-trigger-icon {
      transform: rotate(135deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__cta-icon,
    .header__menu-trigger-icon {
      transition: none;
    }
  }
</style>
