---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NoticeBar from "../components/NoticeBar.astro";
import Hero from "../components/Hero.astro";
import BentoStrip from "../components/BentoStrip.astro";
import Metrics from "../components/Metrics.astro";
import EditorialPortal from "../components/EditorialPortal.astro";
import Specialties from "../components/Specialties.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main class="page-main">
    <NoticeBar />
    <Hero />
    <BentoStrip />
    <Metrics />
    <EditorialPortal />
    <Specialties />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>

<style lang="scss">
  .page-main {
    padding-top: 80px;
    min-height: calc(100vh - 80px);
    background: var(--color-surface);
  }
</style>
