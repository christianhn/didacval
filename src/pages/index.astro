---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HeroIntro from "../components/HeroIntro.astro";
import IntroContext from "../components/IntroContext.astro";
import NoticeBar from "../components/NoticeBar.astro";
import Profile from "../components/Profile.astro";
import Metrics from "../components/Metrics.astro";
import SupportQuote from "../components/SupportQuote.astro";
import EditorialPortal from "../components/EditorialPortal.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Specialties from "../components/Specialties.astro";
---

<Layout>
  <Header />
  <main class="page-main">
    <Hero />
    <NoticeBar />
    <HeroIntro />
    <Profile />
    <Metrics />
    <IntroContext />
    <SupportQuote />
    <EditorialPortal />
    <Specialties />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>

<style lang="scss">
  .page-main {
    // sin padding-top: el Hero video es fullscreen y el header es transparente overlay
    background: var(--color-surface);
  }
</style>
