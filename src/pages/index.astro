---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/layout/Hero.astro";
import IntroContext from "../components/layout/IntroContext.astro";
import NoticeBar from "../components/layout/NoticeBar.astro";
import Profile from "../components/layout/Profile.astro";
import Metrics from "../components/layout/Metrics.astro";
import SupportQuote from "../components/layout/SupportQuote.astro";
import EditorialPortal from "../components/layout/EditorialPortal.astro";
import Process from "../components/layout/Process.astro";
import Faq from "../components/layout/Faq.astro";
import Contact from "../components/layout/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import Specialties from "../components/layout/Specialties.astro";
import Details from "../components/layout/Details.astro";
import handImg from "../assets/ask/hand.jpg";
---

<Layout>
  <Header />
  <main class="page-main">
    <Hero />
    <NoticeBar />
    <Profile />
    <Specialties />
    <Details />
    <Process />
    <!-- <Metrics /> -->
    <!--     
    <IntroContext />
    <SupportQuote /> -->

    <!-- <EditorialPortal /> -->
    <!-- La foto de la mano es de la portada: se pasa aquí porque `Faq.astro` ya
         no la da por defecto, para que una subpágina sin imagen propia no la
         herede. -->
    <Faq image={handImg} />
    <Contact />
  </main>
  <Footer />
</Layout>
